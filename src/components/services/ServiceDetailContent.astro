---
import type { ServiceItem } from '../../data/services';
import { getRelatedServices } from '../../data/services';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { siteConfig } from '../../config/site';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import ServiceCard from '../ui/ServiceCard.astro';
import ServiceBreadcrumb from './ServiceBreadcrumb.astro';
import BackToHomeButton from '../ui/BackToHomeButton.astro';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = service.title[lang];
const subtitle = service.subtitle[lang];
const altText = service.imageAlt[lang];
const currencyLabel = lang === 'ar' ? 'ر.س' : (service.price.currency || 'SAR');
const durationText = service.duration.display[lang];
const relatedServices = getRelatedServices(service.slug, 3);
---

<div class="pt-24 sm:pt-28 pb-24 bg-ivory-50 min-h-screen">
  
  <!-- Top Navigation Bar (Back to Home, Explore Other Services & Breadcrumb) -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between flex-wrap gap-4 py-3 border-b border-champagne-200/60">
      <div class="flex items-center flex-wrap gap-2.5">
        <BackToHomeButton />
        <a
          href={getLocalizedPath('/services', lang)}
          class="inline-flex items-center gap-2 rounded-pill font-medium transition-all duration-200 group border border-champagne-300/80 bg-white/90 backdrop-blur-xs px-4 py-2 text-caption sm:text-body-sm text-chocolate-700 shadow-xs hover:border-bronze-400 hover:bg-champagne-100/60 hover:text-bronze-700 hover:shadow-soft"
          aria-label={t('services.otherServices')}
          data-testid="other-services-btn"
        >
          <span>{t('services.otherServices')}</span>
          <svg
            class:list={["h-4 w-4 shrink-0 text-bronze-500 transition-transform duration-200", lang === 'ar' ? 'group-hover:-translate-x-1' : 'group-hover:translate-x-1']}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            {lang === 'ar' ? (
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6" />
            ) : (
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            )}
          </svg>
        </a>
      </div>
      <ServiceBreadcrumb
        items={[
          { label: t('services.breadcrumbServices'), href: getLocalizedPath('/services', lang) },
          { label: title },
        ]}
      />
    </div>
  </div>

  <!-- Service Hero Header -->
  <header class="relative py-8 sm:py-12 border-b border-champagne-200/60 bg-white/50 backdrop-blur-xs">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        
        <div class="max-w-3xl">
          <!-- Badges -->
          <div class="flex items-center flex-wrap gap-2.5 mb-4">
            {service.isSignature && (
              <span class="inline-flex items-center gap-1.5 rounded-pill bg-bronze-500 px-3.5 py-1 text-caption font-semibold tracking-wider text-ivory-50 uppercase shadow-xs">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {t('common.signature')}
              </span>
            )}
            {lang === 'ar' ? (
              <span class="rounded-pill bg-champagne-200/80 px-3 py-1 text-caption font-medium text-chocolate-700">
                {service.title.en}
              </span>
            ) : (
              <span class="rounded-pill bg-champagne-200/80 px-3 py-1 text-caption font-medium text-chocolate-700 uppercase tracking-wider">
                {service.category} Ritual
              </span>
            )}
          </div>

          <!-- Main Title -->
          <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-chocolate-800 leading-tight mb-3">
            {title}
          </h1>

          <!-- Poetic Subtitle -->
          <p class="text-body sm:text-body-lg text-bronze-600 font-medium leading-relaxed">
            {subtitle}
          </p>
        </div>

        <!-- Quick Summary Pill (Duration & Price) -->
        <div class="flex items-center gap-4 bg-white rounded-2xl border border-champagne-200/80 p-4 shadow-soft shrink-0 self-start lg:self-auto">
          <!-- Duration -->
          <div class="pe-4 border-e border-champagne-200/80">
            <span class="block text-[11px] text-chocolate-400 font-medium uppercase tracking-wider mb-0.5">
              {t('services.duration')}
            </span>
            <span class="font-heading text-body font-bold text-chocolate-800">
              {durationText}
            </span>
          </div>

          <!-- Price -->
          <div>
            <span class="block text-[11px] text-chocolate-400 font-medium uppercase tracking-wider mb-0.5">
              {t('services.price')}
            </span>
            <span class="font-heading text-body font-bold text-bronze-600">
              {service.price.display[lang]}
            </span>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Content Layout (2 Cols: Left Narrative & Details, Right Sticky Booking Box) -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Primary Column (8 cols) -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Hero Visual Media -->
        <div class="relative aspect-[16/9] w-full rounded-card overflow-hidden shadow-elevated bg-chocolate-950 border border-champagne-200/60">
          <img
            src={service.image}
            alt={altText}
            width="800"
            height={service.slug === 'therapeutic-massage' ? '1200' : '533'}
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-chocolate-950/60 via-transparent to-transparent"></div>
          
          <div class="absolute bottom-4 start-4 sm:bottom-6 sm:start-6 text-ivory-50 max-w-md">
            <p class="text-caption sm:text-body-sm font-medium text-champagne-200 backdrop-blur-md bg-chocolate-900/60 px-3 py-1 rounded-pill inline-block">
              {altText}
            </p>
          </div>
        </div>

        <!-- Detailed Description (Narrative) -->
        <section class="rounded-card bg-white p-7 sm:p-9 border border-champagne-200/80 shadow-soft">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="h-px w-6 bg-bronze-400"></span>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-chocolate-800">
              {t('services.ritualOverview')}
            </h2>
          </div>

          <div class="space-y-4 text-body sm:text-body-lg text-chocolate-600 leading-relaxed">
            {service.detailedDescription[lang].map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Key Benefits Grid -->
        <section class="rounded-card bg-white p-7 sm:p-9 border border-champagne-200/80 shadow-soft">
          <div class="inline-flex items-center gap-2 mb-6">
            <span class="h-px w-6 bg-bronze-400"></span>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-chocolate-800">
              {t('services.benefitsTitle')}
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {service.benefits[lang].map((benefit) => (
              <div class="flex items-start gap-3.5 p-4 rounded-xl bg-champagne-50/60 border border-champagne-200/50">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-bronze-500 text-ivory-50 shadow-xs">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span class="text-body-sm font-medium text-chocolate-700 leading-snug pt-0.5">
                  {benefit}
                </span>
              </div>
            ))}
          </div>
        </section>

        <!-- The 4-Step Treatment Journey Timeline -->
        <section class="rounded-card bg-white p-7 sm:p-9 border border-champagne-200/80 shadow-soft">
          <div class="inline-flex items-center gap-2 mb-2">
            <span class="h-px w-6 bg-bronze-400"></span>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-chocolate-800">
              {t('services.stepsTitle')}
            </h2>
          </div>
          <p class="text-body-sm text-chocolate-500 mb-8">
            {lang === 'ar' ? 'رحلة مدروسة تبدأ من لحظة استقبالكِ وتستمر حتى استعادتكِ كامل حيويتكِ.' : 'A thoughtfully orchestrated progression ensuring complete comfort from arrival to awakening.'}
          </p>

          <div class="space-y-6">
            {service.steps[lang].map((item, idx) => (
              <div class="flex gap-4 sm:gap-6 relative">
                <!-- Step Number Bubble -->
                <div class="flex flex-col items-center">
                  <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-chocolate-800 text-champagne-200 font-heading font-bold text-body shadow-soft">
                    {item.step}
                  </div>
                  {idx < service.steps[lang].length - 1 && (
                    <div class="w-px flex-1 bg-champagne-300/80 my-2"></div>
                  )}
                </div>

                <!-- Step Content Card -->
                <div class="flex-1 pb-6">
                  <h3 class="font-heading text-lg font-bold text-chocolate-800 mb-1">
                    {item.title}
                  </h3>
                  <p class="text-body-sm text-chocolate-500 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Session Amenities & Inclusions -->
        <section class="rounded-card bg-white p-7 sm:p-9 border border-champagne-200/80 shadow-soft">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="h-px w-6 bg-bronze-400"></span>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-chocolate-800">
              {t('services.includesTitle')}
            </h2>
          </div>

          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            {service.includes[lang].map((inc) => (
              <li class="flex items-center gap-3 text-body-sm text-chocolate-600">
                <svg class="h-5 w-5 text-bronze-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{inc}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Health, Safety & Privacy Advisory -->
        <section class="rounded-card bg-bronze-50/60 border border-bronze-200/80 p-6 sm:p-7">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bronze-500/15 text-bronze-600">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-body font-bold text-chocolate-800 mb-1">
                {t('services.advisoryTitle')}
              </h3>
              <p class="text-body-sm text-chocolate-600 leading-relaxed mb-2">
                {service.advisory[lang]}
              </p>
              <p class="text-[11px] text-chocolate-400">
                {lang === 'ar'
                  ? 'خصوصيتكِ وسلامتكِ هما أولويتنا المطلقة في كل لحظة تقضينها في ألور سبا.'
                  : 'Your personal privacy and wellbeing are our absolute highest priority at all times.'}
              </p>
            </div>
          </div>
        </section>

      </div>

      <!-- Secondary Column: Sticky Booking Sidebar (4 cols) -->
      <div class="lg:col-span-4">
        <aside class="sticky top-28 space-y-6">
          
          <!-- Booking Card -->
          <div class="rounded-card bg-white p-7 border border-champagne-300/80 shadow-card text-chocolate-800">
            
            <span class="text-caption font-semibold tracking-wider text-bronze-600 uppercase mb-2 block">
              {lang === 'ar' ? 'حجز الموعد والاستفسار' : 'Treatment Reservation'}
            </span>

            <h3 class="font-heading text-2xl font-bold text-chocolate-800 mb-2">
              {title}
            </h3>

            <p class="text-body-sm text-chocolate-500 mb-6">
              {service.description[lang]}
            </p>

            <!-- Price & Duration Highlight Box -->
            <div class="rounded-xl bg-champagne-50 p-4 border border-champagne-200/80 space-y-3 mb-6">
              
              <div class="flex items-center justify-between">
                <span class="text-caption text-chocolate-500">{t('services.duration')}</span>
                <span class="text-body-sm font-semibold text-chocolate-800 flex items-center gap-1.5">
                  <svg class="h-4 w-4 text-bronze-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {durationText}
                </span>
              </div>

              <div class="h-px bg-champagne-200/60"></div>

              <div class="flex items-center justify-between">
                <span class="text-caption text-chocolate-500">{t('services.price')}</span>
                <div class="text-end">
                  <span class="text-body font-bold text-bronze-600 font-heading">
                    {service.price.display[lang]}
                  </span>
                </div>
              </div>

              <p class="text-[10px] text-chocolate-400 text-center pt-1 border-t border-champagne-200/40 italic">
                {service.price.note[lang]}
              </p>
            </div>

            <!-- Booking Actions -->
            <div class="space-y-3">
              <WhatsAppButton
                serviceName={title}
                variant="primary"
                size="lg"
                label={t('services.bookThisService')}
                class="w-full justify-center shadow-soft"
              />

              <a
                href={getLocalizedPath('/#contact', lang)}
                class="inline-flex items-center justify-center gap-2 w-full rounded-pill border border-champagne-300 bg-white px-6 py-3.5 text-body-sm font-semibold text-chocolate-700 transition-colors hover:bg-champagne-50 hover:border-bronze-400 text-center"
              >
                <svg class="h-4 w-4 text-bronze-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <span>{lang === 'ar' ? 'طلب استشارة هاتفية' : 'Telephone Consultation'}</span>
              </a>
            </div>

            <!-- Trust badges list -->
            <div class="pt-6 mt-6 border-t border-champagne-200/60 space-y-2.5 text-caption text-chocolate-500">
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-bronze-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{lang === 'ar' ? 'أجنحة خاصة 100% للسيدات' : '100% Private Women Only Suites'}</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-bronze-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{lang === 'ar' ? 'أخصائيات معتمدات وذوات خبرة' : 'Certified Professional Female Therapists'}</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-bronze-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{lang === 'ar' ? 'زيوت ومستخلصات طبيعية فاخرة' : 'Pure Botanical Oils & Natural Formulations'}</span>
              </div>
            </div>

          </div>

          <!-- Back to Catalog / Other Services Link -->
          <div class="text-center">
            <a
              href={getLocalizedPath('/services', lang)}
              class="inline-flex items-center justify-center gap-2 w-full rounded-pill border border-champagne-300 bg-champagne-50/60 hover:bg-bronze-500 hover:text-ivory-50 hover:border-bronze-500 px-5 py-3 text-body-sm font-semibold text-chocolate-700 transition-all duration-200 shadow-xs"
            >
              <span>{t('services.otherServices')}</span>
              <svg
                class:list={["h-4 w-4 shrink-0 transition-transform duration-200", lang === 'ar' ? 'rotate-0' : 'rotate-180']}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
            </a>
          </div>

        </aside>
      </div>

    </div>

    <!-- Related / Complementary Services Section -->
    <section class="mt-20 pt-16 border-t border-champagne-200/80">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-caption font-semibold tracking-wider text-bronze-600 uppercase mb-2 block">
          {t('services.relatedTitle')}
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-chocolate-800">
          {lang === 'ar' ? 'اكتشفي المزيد من طقوس الاسترخاء' : 'Explore Complementary Wellness Rituals'}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {relatedServices.map((relService) => (
          <ServiceCard service={relService} />
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href={getLocalizedPath('/services', lang)}
          class="btn btn-secondary px-8 py-3.5 text-body-sm font-semibold rounded-pill inline-flex items-center gap-2.5 shadow-soft hover:shadow-card"
        >
          <span>{t('services.otherServices')}</span>
          <svg class="h-4 w-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </section>

  </div>

  <!-- Mobile Floating Quick-Booking Bar -->
  <aside class="fixed bottom-4 inset-x-4 z-40 lg:hidden" aria-label={lang === 'ar' ? 'حجز سريع' : 'Quick Booking'}>
    <div class="rounded-pill p-2 bg-chocolate-950/95 backdrop-blur-md border border-bronze-500/50 shadow-elevated flex items-center justify-between gap-3">
      <div class="ps-3 text-ivory-50">
        <span class="block text-[10px] text-champagne-300 font-medium">
          {durationText}
        </span>
        <span class="text-caption font-bold text-bronze-400 font-heading">
          {service.price.display[lang]}
        </span>
      </div>

      <WhatsAppButton
        serviceName={title}
        variant="primary"
        size="md"
        label={t('common.bookNow')}
        class="shrink-0 !py-2.5 !px-5 text-body-sm shadow-none"
      />
    </div>
  </aside>

</div>
