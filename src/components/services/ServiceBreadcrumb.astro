---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Home item is always first
const fullItems = [
  { label: t('services.breadcrumbHome'), href: getLocalizedPath('/', lang) },
  ...items,
];
---

<nav aria-label="Breadcrumb" class:list={["py-2", className]}>
  <ol class="flex items-center flex-wrap gap-2 text-caption sm:text-body-sm text-chocolate-500">
    {fullItems.map((item, index) => {
      const isLast = index === fullItems.length - 1;
      return (
        <li class="inline-flex items-center gap-2">
          {index > 0 && (
            <svg
              class:list={[
                "h-3.5 w-3.5 text-champagne-400 shrink-0",
                lang === 'ar' ? 'rotate-180' : ''
              ]}
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {isLast || !item.href ? (
            <span class="font-medium text-chocolate-800 line-clamp-1" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="text-chocolate-500 hover:text-bronze-600 transition-colors"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
