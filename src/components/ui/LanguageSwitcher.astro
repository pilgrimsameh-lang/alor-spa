---
import { getLangFromUrl, getAlternateLang, getLocalizedPath } from '../../i18n/utils';
import { languages } from '../../i18n/translations';

interface Props {
  class?: string;
  variant?: 'nav' | 'floating' | 'footer';
}

const { class: className = '', variant = 'nav' } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const targetLang = getAlternateLang(currentLang);
const targetLabel = languages[targetLang];

// Calculate target URL preserving pathname
const pathname = Astro.url.pathname;
let targetHref = '/';

if (currentLang === 'ar') {
  // Currently Arabic, switch to English (/en/...)
  targetHref = pathname === '/' ? '/en/' : `/en${pathname}`;
} else {
  // Currently English, switch to Arabic (remove /en)
  targetHref = pathname.replace(/^\/en(\/|$)/, '$1') || '/';
}
---

<a
  href={targetHref}
  class:list={[
    'inline-flex items-center gap-2 font-medium transition-all duration-300 ease-elegant',
    variant === 'nav' &&
      'rounded-pill border border-champagne-300/40 bg-chocolate-900/60 px-3.5 py-1.5 text-body-sm text-ivory-100 hover:border-bronze-400 hover:bg-chocolate-800 hover:text-bronze-300',
    variant === 'floating' &&
      'fixed start-6 bottom-6 z-40 rounded-pill bg-chocolate-900/90 px-4 py-2.5 text-body-sm text-ivory-100 shadow-elevated backdrop-blur-md border border-bronze-500/30 hover:bg-chocolate-800 hover:border-bronze-400',
    variant === 'footer' &&
      'text-body-sm text-champagne-300 hover:text-bronze-300 underline-offset-4 hover:underline',
    className,
  ]}
  aria-label={targetLang === 'ar' ? 'التبديل إلى اللغة العربية' : 'Switch to English'}
>
  <svg class="h-4 w-4 text-bronze-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 003 12c0-1.605.42-3.113 1.157-4.418" />
  </svg>
  <span>{targetLabel}</span>
</a>
