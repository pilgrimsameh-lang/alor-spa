---
import { getLangFromUrl, getDirection, useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  class?: string;
  variant?: 'luxury' | 'subtle';
}

const {
  class: className = '',
  variant = 'luxury',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dir = getDirection(lang);
const isRtl = dir === 'rtl';
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/en' || pathname === '/en/';

const homeHref = getLocalizedPath('/', lang);
const label = t('common.backToHome');
const ariaLabel = lang === 'ar' ? 'العودة إلى الصفحة الرئيسية' : 'Back to Home';
---

{!isHome && (
  <a
    href={homeHref}
    class:list={[
      "inline-flex items-center gap-2 rounded-pill font-medium transition-all duration-200 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bronze-400 focus-visible:ring-offset-2",
      variant === 'luxury' && "border border-champagne-300/80 bg-white/90 backdrop-blur-xs px-4 py-2 text-caption sm:text-body-sm text-chocolate-700 shadow-xs hover:border-bronze-400 hover:bg-champagne-100/60 hover:text-bronze-700 hover:shadow-soft",
      variant === 'subtle' && "text-caption sm:text-body-sm text-chocolate-600 hover:text-bronze-600 py-1.5",
      className,
    ]}
    aria-label={ariaLabel}
    data-testid="back-to-home"
  >
    <span>{label}</span>

    {isRtl ? (
      /* RTL Arrow: Points LEFT (سهم لليسار في RTL) */
      <svg
        class="h-4 w-4 shrink-0 text-bronze-500 transition-transform duration-200 group-hover:-translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        data-arrow-dir="left"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6" />
      </svg>
    ) : (
      /* LTR Arrow: Points RIGHT (سهم لليمين في LTR) */
      <svg
        class="h-4 w-4 shrink-0 text-bronze-500 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        data-arrow-dir="right"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    )}
  </a>
)}
