---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'start';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  class: className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center' : 'text-start';
---

<div class:list={['section-header', alignClass, className]}>
  {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
  <h2 class="section-title text-h2 font-bold text-chocolate-800">{title}</h2>
  
  <div class:list={['divider-diamond', align === 'start' ? 'justify-start' : 'justify-center']}>
    <span></span>
  </div>

  {subtitle && (
    <p class="mx-auto max-w-2xl text-body-lg text-chocolate-500 leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
