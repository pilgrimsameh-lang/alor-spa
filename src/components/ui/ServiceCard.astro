---
import type { ServiceItem } from '../../data/services';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = service.title[lang];
const subtitle = service.subtitle[lang];
const description = service.description[lang];
const features = service.features[lang];
const altText = service.imageAlt[lang];

// Price & Duration formatting
const priceText = service.price?.isConfirmed && service.price?.amount
  ? `${service.price.amount} ${lang === 'ar' ? 'ر.س' : 'SAR'}`
  : service.price.display[lang];

const durationText = service.duration?.isConfirmed && service.duration?.minutes
  ? `${service.duration.minutes} ${lang === 'ar' ? 'دقيقة' : 'Mins'}`
  : service.duration.display[lang];
---

<article
  class="group flex flex-col h-full rounded-card bg-white border border-champagne-200/80 shadow-soft transition-all duration-300 ease-elegant hover:shadow-card hover:border-bronze-300 overflow-hidden"
  id={service.slug}
>
  <!-- Card Visual Header -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-chocolate-900">
    <img
      src={service.image}
      alt={altText}
      width="800"
      height={service.slug === 'therapeutic-massage' ? '1200' : '533'}
      class="h-full w-full object-cover transition-transform duration-700 ease-elegant group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-chocolate-950/70 via-transparent to-transparent"></div>

    <!-- Category / Signature Tag -->
    {service.isSignature && (
      <span class="absolute top-4 start-4 inline-flex items-center gap-1.5 rounded-pill bg-bronze-500/90 backdrop-blur-md px-3 py-1 text-[11px] font-semibold tracking-wider text-ivory-50 uppercase shadow-sm">
        <svg class="h-3 w-3 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        {t('common.signature')}
      </span>
    )}

    <!-- Secondary Language Title Pill (English in Arabic view, category badge in English view) -->
    {lang === 'ar' ? (
      <span class="absolute bottom-3 end-3 rounded-pill bg-chocolate-950/75 backdrop-blur-sm px-2.5 py-0.5 text-caption font-medium text-champagne-200">
        {service.title.en}
      </span>
    ) : (
      <span class="absolute bottom-3 end-3 rounded-pill bg-chocolate-950/75 backdrop-blur-sm px-2.5 py-0.5 text-caption font-medium text-champagne-200 uppercase tracking-wider">
        {service.category}
      </span>
    )}
  </div>

  <!-- Card Body -->
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    
    <!-- Title & Subtitle -->
    <div class="mb-3">
      <h3 class="font-heading text-xl sm:text-2xl font-bold text-chocolate-800 transition-colors group-hover:text-bronze-600 mb-1">
        <a href={getLocalizedPath(`/services/${service.slug}`, lang)} class="hover:underline underline-offset-4">
          {title}
        </a>
      </h3>
      <p class="text-caption sm:text-body-sm font-medium text-bronze-500">
        {subtitle}
      </p>
    </div>

    <!-- Short Description -->
    <p class="text-body-sm text-chocolate-500 leading-relaxed mb-5 flex-1">
      {description}
    </p>

    <!-- Key Highlights / Features -->
    <ul class="space-y-2 mb-5 pt-4 border-t border-champagne-200/50">
      {features.slice(0, 3).map((feature) => (
        <li class="flex items-start gap-2.5 text-caption sm:text-body-sm text-chocolate-600">
          <span class="h-1.5 w-1.5 rounded-full bg-bronze-400 mt-1.5 shrink-0"></span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>

    <!-- Price and Duration Meta Section -->
    <div class="mb-4 rounded-xl bg-champagne-50/70 border border-champagne-200/60 p-3 flex items-center justify-between text-body-sm">
      <!-- Duration -->
      <div class="flex items-center gap-1.5 text-chocolate-700">
        <svg class="h-4 w-4 text-bronze-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-caption font-medium">{durationText}</span>
      </div>

      <!-- Price -->
      <div class="flex items-center gap-1 text-end">
        <span class="text-caption font-bold text-bronze-600">
          {priceText}
        </span>
      </div>
    </div>

    <p class="text-[10px] text-chocolate-400 text-center -mt-2 mb-4 italic">
      {lang === 'ar' ? '* يتم تأكيد السعر والمدة بدقة عند التواصل مع الاستقبال' : '* Pricing & duration confirmed upon consultation'}
    </p>

    <!-- Card Action Buttons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
      <WhatsAppButton
        serviceName={title}
        variant="primary"
        size="sm"
        label={t('common.bookNow')}
        class="w-full justify-center"
      />
      <a
        href={getLocalizedPath(`/services/${service.slug}`, lang)}
        class="inline-flex items-center justify-center gap-1.5 rounded-pill border border-champagne-300 bg-white px-4 py-2 text-body-sm font-medium text-chocolate-700 transition-colors hover:border-bronze-400 hover:text-bronze-600 hover:bg-champagne-50 text-center"
        aria-label={`${t('services.viewCard')} - ${title}`}
      >
        <span>{t('services.viewCard')}</span>
      </a>
    </div>

  </div>
</article>
