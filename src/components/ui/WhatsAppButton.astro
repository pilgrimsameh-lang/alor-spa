---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { isWhatsAppConfigured, getWhatsAppBookingUrl } from '../../config/site';

interface Props {
  serviceName?: string;
  variant?: 'primary' | 'secondary' | 'light' | 'card' | 'compact';
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  class?: string;
  showIcon?: boolean;
}

const {
  serviceName,
  variant = 'primary',
  size = 'md',
  label,
  class: className = '',
  showIcon = true,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isConfigured = isWhatsAppConfigured();
const whatsappUrl = getWhatsAppBookingUrl(lang, serviceName);

const defaultText = label || t('common.bookNow');

const variantClasses = {
  primary: 'bg-bronze-500 text-ivory-50 hover:bg-bronze-400 shadow-soft hover:shadow-card active:scale-[0.98]',
  secondary: 'border border-bronze-500/40 text-chocolate-700 hover:border-bronze-500 hover:text-bronze-500 hover:bg-champagne-50 active:scale-[0.98]',
  light: 'border border-ivory-300/40 text-ivory-100 hover:border-bronze-400 hover:text-bronze-300 hover:bg-chocolate-800/40 active:scale-[0.98]',
  card: 'bg-chocolate-800 text-ivory-50 hover:bg-bronze-500 shadow-soft hover:shadow-card active:scale-[0.98]',
  compact: 'bg-bronze-500/10 text-bronze-600 hover:bg-bronze-500 hover:text-ivory-50 text-body-sm px-4 py-2',
};

const sizeClasses = {
  sm: 'px-4 py-2 text-body-sm',
  md: 'px-6 py-3 text-body',
  lg: 'px-8 py-4 text-body-lg',
};

const hasValidUrl = Boolean(isConfigured && whatsappUrl);
const resolvedHref = hasValidUrl ? (whatsappUrl as string) : getLocalizedPath('/#contact', lang);
const resolvedTarget = hasValidUrl ? '_blank' : undefined;
const resolvedRel = hasValidUrl ? 'noopener noreferrer' : undefined;
const ariaLabel = hasValidUrl
  ? `${defaultText} ${serviceName ? `(${serviceName})` : ''}`
  : `${defaultText} - ${t('booking.unconfiguredNotice')}`;
---

<a
  href={resolvedHref}
  target={resolvedTarget}
  rel={resolvedRel}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-pill font-semibold transition-all duration-300 ease-elegant text-center whitespace-nowrap cursor-pointer',
    variantClasses[variant],
    sizeClasses[size],
    className,
  ]}
  aria-label={ariaLabel}
  title={!hasValidUrl ? t('booking.unconfiguredNotice') : undefined}
  data-whatsapp-booking={hasValidUrl ? 'active' : 'unconfigured'}
>
  {showIcon && (
    <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
  )}
  <span>{defaultText}</span>
</a>
