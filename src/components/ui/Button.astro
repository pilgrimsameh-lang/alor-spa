---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'light';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  ...rest
} = Astro.props;

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost',
  light: 'btn-light',
};

const sizeClasses = {
  sm: 'btn-sm',
  md: '',
  lg: 'btn-lg',
};

const isLink = typeof href === 'string';
const resolvedRel = target === '_blank' && !rel ? 'noopener noreferrer' : rel;
---

{
  isLink ? (
    <a
      href={href}
      target={target}
      rel={resolvedRel}
      class:list={['btn', variantClasses[variant], sizeClasses[size], className]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={['btn', variantClasses[variant], sizeClasses[size], className]}
      {...rest}
    >
      <slot />
    </button>
  )
}
