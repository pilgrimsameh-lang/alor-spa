---
import type { AdminUserLocal } from '../../server/auth/rbac';
import { getAccessibleNavItems, ADMIN_GROUPS } from '../../server/auth/admin-nav';

interface Props {
  user: AdminUserLocal;
  currentPath: string;
  lang?: 'ar' | 'en';
}

const {
  user,
  currentPath,
  lang = 'ar',
} = Astro.props;

const isRtl = lang === 'ar';
const accessibleItems = getAccessibleNavItems(user);
const normalizedPath = currentPath.replace(/\/$/, '') || '/admin';

let newBookingsCount = 0;
try {
  const client = Astro.locals.dbClient;
  if (client) {
    const res = await client.execute("SELECT COUNT(*) as count FROM booking_requests WHERE status = 'new';");
    newBookingsCount = Number(res.rows[0]?.count ?? 0);
  }
} catch (e) {
  newBookingsCount = 0;
}

const roleDisplayMap: Record<string, { ar: string; en: string }> = {
  super_admin: { ar: 'المدير العام للنظام', en: 'Super Administrator' },
  role_super_admin: { ar: 'المدير العام للنظام', en: 'Super Administrator' },
  spa_manager: { ar: 'مديرة السبا', en: 'Spa Manager' },
  role_spa_manager: { ar: 'مديرة السبا', en: 'Spa Manager' },
  content_editor: { ar: 'محررة المحتوى', en: 'Content Editor' },
  role_content_editor: { ar: 'محررة المحتوى', en: 'Content Editor' },
};

const userRoleLabel = roleDisplayMap[user.roleSlug] || roleDisplayMap[user.roleId] || { ar: user.roleSlug, en: user.roleSlug };
---

<!-- Mobile Backdrop Overlay -->
<div
  id="admin-sidebar-backdrop"
  class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Main Aside Sidebar -->
<aside
  id="admin-sidebar"
  class="fixed top-0 bottom-0 z-50 flex flex-col bg-[#140D09] border-r border-[#A87952]/20 transition-all duration-300 select-none
    lg:translate-x-0 -translate-x-full lg:static lg:h-screen lg:shrink-0
    w-72 data-[collapsed=true]:w-20
    ltr:left-0 rtl:right-0 rtl:border-r-0 rtl:border-l rtl:translate-x-full lg:rtl:translate-x-0"
  data-collapsed="false"
  aria-label="Admin Navigation"
>
  <!-- Brand / Logo Header -->
  <div class="h-20 flex items-center justify-between px-5 border-b border-[#A87952]/20 bg-[#1C130D]/50">
    <a href="/admin" class="flex items-center gap-3 group overflow-hidden">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#38251F] to-[#1C130D] border border-[#C5A880]/40 flex items-center justify-center shrink-0 shadow-md group-hover:border-[#C5A880] transition-colors">
        <svg class="w-5 h-5 text-[#C5A880]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
        </svg>
      </div>
      <div class="sidebar-text-expand flex flex-col overflow-hidden whitespace-nowrap transition-opacity duration-200">
        <span class="text-base font-bold font-['Amiri',serif] text-[#FAF7F2] tracking-wide leading-tight group-hover:text-[#C5A880] transition-colors">
          ألور سبا
        </span>
        <span class="text-[10px] uppercase tracking-widest text-[#D8C4A3]/60 font-light">
          {isRtl ? 'لوحة الإدارة المعتمدة' : 'Official Admin Portal'}
        </span>
      </div>
    </a>

    <!-- Mobile Close Button -->
    <button
      id="admin-sidebar-close-btn"
      class="lg:hidden p-2 rounded-lg text-[#D8C4A3]/70 hover:text-[#FAF7F2] hover:bg-[#38251F]/40 transition-colors cursor-pointer"
      aria-label="Close Sidebar"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Scrollable Navigation Items -->
  <nav class="flex-1 overflow-y-auto px-3 py-6 space-y-6 scrollbar-thin scrollbar-thumb-[#38251F] scrollbar-track-transparent">
    {ADMIN_GROUPS.map((group) => {
      const itemsInGroup = accessibleItems.filter((i) => i.group === group.id);
      if (itemsInGroup.length === 0) return null;

      return (
        <div class="space-y-1.5">
          <div class="sidebar-group-title px-3 mb-2 flex items-center">
            <span class="text-[11px] font-semibold tracking-wider text-[#A87952] uppercase font-['Tajawal',sans-serif]">
              {isRtl ? group.titleAr : group.titleEn}
            </span>
          </div>

          <ul class="space-y-1">
            {itemsInGroup.map((item) => {
              const isActive =
                item.href === '/admin'
                  ? normalizedPath === '/admin'
                  : normalizedPath === item.href || normalizedPath.startsWith(`${item.href}/`);

              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all duration-200 group relative',
                      isActive
                        ? 'bg-gradient-to-r from-[#38251F] to-[#241814] text-[#FAF7F2] border border-[#C5A880]/40 shadow-sm shadow-black/30 font-semibold'
                        : 'text-[#D8C4A3]/75 hover:bg-[#1C130D] hover:text-[#FAF7F2] border border-transparent hover:border-[#A87952]/20',
                    ]}
                    title={isRtl ? item.titleAr : item.titleEn}
                  >
                    <!-- Active Indicator Notch (RTL & LTR) -->
                    {isActive && (
                      <span class="absolute inset-y-1.5 w-1 rounded-full bg-[#C5A880] rtl:right-1.5 ltr:left-1.5 shadow-[0_0_8px_#C5A880]"></span>
                    )}

                    <!-- Item Icon -->
                    <div class:list={[
                      'w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors',
                      isActive
                        ? 'text-[#C5A880]'
                        : 'text-[#A87952] group-hover:text-[#D8C4A3]',
                    ]}>
                      {item.icon === 'dashboard' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                      )}
                      {item.icon === 'services' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                        </svg>
                      )}
                      {item.icon === 'categories' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                      )}
                      {item.icon === 'offers' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                        </svg>
                      )}
                      {item.icon === 'gallery' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      )}
                      {item.icon === 'reviews' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                        </svg>
                      )}
                      {item.icon === 'blog' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                        </svg>
                      )}
                      {item.icon === 'media' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                      )}
                      {item.icon === 'settings' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                      )}
                      {item.icon === 'users' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                      )}
                      {item.icon === 'roles' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                      )}
                      {item.icon === 'logs' && (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      )}
                    </div>

                    <!-- Label -->
                    <span class="sidebar-text-expand truncate transition-opacity duration-200">
                      {isRtl ? item.titleAr : item.titleEn}
                    </span>
                  </a>
                </li>
              );
            })}
            {group.id === 'overview' && (
              <li>
                <a
                  href="/admin/bookings"
                  class:list={[
                    'flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-all duration-200 group relative',
                    normalizedPath === '/admin/bookings' || normalizedPath.startsWith('/admin/bookings/')
                      ? 'bg-gradient-to-r from-[#38251F] to-[#241814] text-[#FAF7F2] border border-[#C5A880]/40 shadow-sm shadow-black/30 font-semibold'
                      : 'text-[#D8C4A3]/75 hover:bg-[#1C130D] hover:text-[#FAF7F2] border border-transparent hover:border-[#A87952]/20',
                  ]}
                  title={isRtl ? 'طلبات الحجز والتواصل' : 'Booking & Contact Requests'}
                >
                  {(normalizedPath === '/admin/bookings' || normalizedPath.startsWith('/admin/bookings/')) && (
                    <span class="absolute inset-y-1.5 w-1 rounded-full bg-[#C5A880] rtl:right-1.5 ltr:left-1.5 shadow-[0_0_8px_#C5A880]"></span>
                  )}
                  <div class="flex items-center gap-3">
                    <div class:list={[
                      'w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors',
                      normalizedPath.startsWith('/admin/bookings') ? 'text-[#C5A880]' : 'text-[#A87952] group-hover:text-[#D8C4A3]'
                    ]}>
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <span class="sidebar-text-expand truncate transition-opacity duration-200">
                      {isRtl ? 'طلبات الحجز' : 'Booking Requests'}
                    </span>
                  </div>
                  {newBookingsCount > 0 && (
                    <span class="sidebar-text-expand px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                      {newBookingsCount}
                    </span>
                  )}
                </a>
              </li>
            )}
          </ul>
        </div>
      );
    })}
  </nav>

  <!-- Sidebar Footer: User Brief Profile -->
  <div class="p-4 border-t border-[#A87952]/20 bg-[#1C130D]/70">
    <div class="flex items-center gap-3 overflow-hidden">
      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#A87952] to-[#7A5230] text-[#FAF7F2] font-bold text-xs flex items-center justify-center shrink-0 border border-[#C5A880]/30 shadow-inner">
        {user.fullName.slice(0, 1).toUpperCase()}
      </div>
      <div class="sidebar-text-expand flex flex-col overflow-hidden min-w-0">
        <span class="text-xs font-semibold text-[#FAF7F2] truncate">
          {user.fullName}
        </span>
        <span class="text-[10px] text-[#C5A880] truncate font-light">
          {isRtl ? userRoleLabel.ar : userRoleLabel.en}
        </span>
      </div>
    </div>
  </div>
</aside>

<style>
  /* Handle desktop collapsed mode styling */
  [data-collapsed="true"] .sidebar-text-expand {
    display: none !important;
  }
  [data-collapsed="true"] .sidebar-group-title {
    display: none !important;
  }
  [data-collapsed="true"] a {
    justify-content: center !important;
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }
</style>
