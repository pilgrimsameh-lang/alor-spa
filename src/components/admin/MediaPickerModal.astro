---
export interface Props {
  id: string;
  name: string;
  label?: string;
  required?: boolean;
  initialMediaId?: string | null;
  initialImageUrl?: string | null;
  initialImageName?: string | null;
  lang?: 'ar' | 'en';
}

const {
  id,
  name,
  label,
  required = false,
  initialMediaId = '',
  initialImageUrl = '',
  initialImageName = '',
  lang = 'ar',
} = Astro.props;

const isRtl = lang === 'ar';
---

<div class="media-picker-widget" id={id} data-required={required ? 'true' : 'false'}>
  {label && (
    <label class="block text-xs text-[#D8C4A3] mb-1">
      {label} {required && <span class="text-amber-400">*</span>}
    </label>
  )}

  <!-- Hidden field holding the media_id for the parent form -->
  <input
    type="hidden"
    id={`${id}-value`}
    name={name}
    value={initialMediaId || ''}
    required={required}
  />

  <!-- Display State: Selected Image Preview -->
  <div
    id={`${id}-preview-box`}
    class={`${initialImageUrl ? '' : 'hidden'} p-2.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 flex items-center justify-between gap-3`}
  >
    <div class="flex items-center gap-3 overflow-hidden">
      <img
        id={`${id}-preview-img`}
        src={initialImageUrl || ''}
        alt={initialImageName || 'Selected media'}
        class="w-12 h-12 object-cover rounded-lg border border-[#A87952]/30 shrink-0 bg-black/40"
      />
      <div class="overflow-hidden">
        <span id={`${id}-preview-name`} class="block text-xs font-medium text-[#FAF7F2] truncate">
          {initialImageName || initialMediaId || (isRtl ? 'صورة مختارة' : 'Selected Image')}
        </span>
        <span id={`${id}-preview-url`} class="block text-[10px] text-[#D8C4A3]/50 font-mono truncate">
          {initialImageUrl || ''}
        </span>
      </div>
    </div>

    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id={`${id}-change-btn`}
        class="px-2.5 py-1.5 rounded-lg bg-[#241814] hover:bg-[#C5A880] text-[#D8C4A3] hover:text-[#140D09] text-[11px] font-medium transition-colors cursor-pointer border border-[#A87952]/20"
      >
        {isRtl ? 'تغيير' : 'Change'}
      </button>
      {!required && (
        <button
          type="button"
          id={`${id}-remove-btn`}
          class="p-1.5 rounded-lg bg-red-950/40 hover:bg-red-600/80 text-red-300 hover:text-white text-xs transition-colors cursor-pointer"
          title={isRtl ? 'إزالة الصورة' : 'Remove Image'}
        >
          ✕
        </button>
      )}
    </div>
  </div>

  <!-- Empty State: No image chosen -->
  <div
    id={`${id}-empty-box`}
    class={`${initialImageUrl ? 'hidden' : ''} border border-dashed border-[#A87952]/35 rounded-xl p-3 bg-[#140D09]/50 flex items-center justify-between gap-3`}
  >
    <div class="flex items-center gap-2.5 text-[#D8C4A3]/60 text-xs">
      <svg class="w-5 h-5 text-[#C5A880]/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span>{isRtl ? 'لم يتم اختيار صورة' : 'No image selected'}</span>
    </div>

    <button
      type="button"
      id={`${id}-select-btn`}
      class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#241814] border border-[#A87952]/30 text-[#FAF7F2] hover:bg-[#C5A880] hover:text-[#140D09] transition-all cursor-pointer shadow-sm"
    >
      {isRtl ? 'اختيار أو رفع صورة' : 'Select / Upload'}
    </button>
  </div>

  <!-- Reusable Picker Modal Dialog -->
  <div
    id={`${id}-modal`}
    class="hidden fixed inset-0 z-[60] bg-black/85 backdrop-blur-sm flex items-center justify-center p-4"
  >
    <div class="bg-[#1C130D] border border-[#A87952]/30 rounded-2xl w-full max-w-3xl p-6 shadow-2xl flex flex-col max-h-[85vh]">
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-3 border-b border-[#A87952]/20 mb-4 shrink-0">
        <div>
          <h3 class="text-base font-bold font-['Amiri',serif] text-[#FAF7F2]">
            {isRtl ? 'اختيار صورة من مكتبة الوسائط' : 'Select Image from Media Library'}
          </h3>
          <p class="text-xs text-[#D8C4A3]/60">
            {isRtl ? 'اختر صورة موجودة أو ارفع صورة جديدة مباشرة' : 'Choose an existing image or upload a new one directly'}
          </p>
        </div>
        <button
          type="button"
          id={`${id}-modal-close-btn`}
          class="text-[#D8C4A3]/60 hover:text-[#FAF7F2] text-xl cursor-pointer"
        >
          ✕
        </button>
      </div>

      <!-- Action Bar: Search & Quick Upload -->
      <div class="flex flex-col sm:flex-row gap-3 mb-4 shrink-0">
        <div class="relative flex-1">
          <input
            type="text"
            id={`${id}-modal-search`}
            placeholder={isRtl ? 'بحث باسم الملف أو العنوان...' : 'Search by name or title...'}
            class="w-full ps-9 pe-3 py-1.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
          />
          <svg class="w-4 h-4 absolute top-2 start-2.5 text-[#D8C4A3]/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <label class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] transition-all shadow cursor-pointer flex items-center justify-center gap-1.5 shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span id={`${id}-upload-label`}>{isRtl ? 'رفع صورة جديدة' : 'Upload New'}</span>
          <input type="file" id={`${id}-direct-upload-input`} accept="image/jpeg,image/png,image/webp" class="hidden" />
        </label>
      </div>

      <!-- Scrollable Grid Container -->
      <div id={`${id}-items-container`} class="overflow-y-auto flex-1 min-h-[220px] p-1">
        <div id={`${id}-grid`} class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3">
          <!-- Dynamically populated or loaded via fetch -->
        </div>
        <div id={`${id}-loading`} class="text-center py-10 text-xs text-[#D8C4A3]/60">
          {isRtl ? 'جاري تحميل مكتبة الصور...' : 'Loading media assets...'}
        </div>
        <div id={`${id}-no-results`} class="hidden text-center py-10 text-xs text-[#D8C4A3]/60">
          {isRtl ? 'لا توجد نتائج مطابقة' : 'No matching images found'}
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="pt-3 border-t border-[#A87952]/20 flex items-center justify-end shrink-0 mt-3">
        <button
          type="button"
          id={`${id}-modal-cancel-btn`}
          class="px-4 py-1.5 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer"
        >
          {isRtl ? 'إغلاق' : 'Close'}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ id, isRtl }}>
  (function () {
    const root = document.getElementById(id);
    if (!root) return;

    const valueInput = document.getElementById(`${id}-value`);
    const previewBox = document.getElementById(`${id}-preview-box`);
    const emptyBox = document.getElementById(`${id}-empty-box`);
    const previewImg = document.getElementById(`${id}-preview-img`);
    const previewName = document.getElementById(`${id}-preview-name`);
    const previewUrl = document.getElementById(`${id}-preview-url`);

    const selectBtn = document.getElementById(`${id}-select-btn`);
    const changeBtn = document.getElementById(`${id}-change-btn`);
    const removeBtn = document.getElementById(`${id}-remove-btn`);

    const modal = document.getElementById(`${id}-modal`);
    const modalCloseBtn = document.getElementById(`${id}-modal-close-btn`);
    const modalCancelBtn = document.getElementById(`${id}-modal-cancel-btn`);
    const modalSearch = document.getElementById(`${id}-modal-search`);
    const grid = document.getElementById(`${id}-grid`);
    const loading = document.getElementById(`${id}-loading`);
    const noResults = document.getElementById(`${id}-no-results`);
    const directUploadInput = document.getElementById(`${id}-direct-upload-input`);
    const uploadLabel = document.getElementById(`${id}-upload-label`);

    let cachedMedia = [];

    // Open Modal
    function openModal() {
      modal.classList.remove('hidden');
      loadMedia();
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    selectBtn?.addEventListener('click', openModal);
    changeBtn?.addEventListener('click', openModal);
    modalCloseBtn?.addEventListener('click', closeModal);
    modalCancelBtn?.addEventListener('click', closeModal);

    // Remove selection
    removeBtn?.addEventListener('click', () => {
      valueInput.value = '';
      previewImg.src = '';
      previewName.textContent = '';
      previewUrl.textContent = '';
      previewBox.classList.add('hidden');
      emptyBox.classList.remove('hidden');
    });

    // Select an item
    function selectItem(media) {
      valueInput.value = media.id;
      previewImg.src = media.public_url;
      previewName.textContent = media.original_name || media.filename;
      previewUrl.textContent = media.public_url;
      previewBox.classList.remove('hidden');
      emptyBox.classList.add('hidden');
      closeModal();
    }

    // Expose programmatic setter for editing existing records
    root.setSelectedMedia = function (mediaId, imageUrl, imageName) {
      if (mediaId && imageUrl) {
        valueInput.value = mediaId;
        previewImg.src = imageUrl;
        previewName.textContent = imageName || mediaId;
        previewUrl.textContent = imageUrl;
        previewBox.classList.remove('hidden');
        emptyBox.classList.add('hidden');
      } else {
        valueInput.value = '';
        previewImg.src = '';
        previewName.textContent = '';
        previewUrl.textContent = '';
        previewBox.classList.add('hidden');
        emptyBox.classList.remove('hidden');
      }
    };

    // Load media list from API
    async function loadMedia() {
      if (cachedMedia.length > 0) {
        renderGrid(cachedMedia);
        return;
      }
      loading.classList.remove('hidden');
      grid.innerHTML = '';

      try {
        const res = await fetch('/api/admin/media');
        const data = await res.json();
        if (res.ok && data.success) {
          cachedMedia = data.data || [];
          renderGrid(cachedMedia);
        } else {
          loading.textContent = data.error || (isRtl ? 'تعذر جلب الصور' : 'Failed to load media');
        }
      } catch (err) {
        loading.textContent = isRtl ? 'خطأ في الاتصال بالخادم' : 'Server connection error';
      } finally {
        loading.classList.add('hidden');
      }
    }

    function renderGrid(items) {
      grid.innerHTML = '';
      const query = (modalSearch.value || '').trim().toLowerCase();
      const filtered = items.filter((m) => {
        if (!query) return true;
        const name = (m.original_name || m.filename || '').toLowerCase();
        const alt = (m.alt_ar || m.alt_en || '').toLowerCase();
        return name.includes(query) || alt.includes(query);
      });

      if (filtered.length === 0) {
        noResults.classList.remove('hidden');
        return;
      }
      noResults.classList.add('hidden');

      filtered.forEach((m) => {
        const card = document.createElement('div');
        card.className =
          'rounded-xl bg-[#140D09] border border-[#A87952]/20 hover:border-[#C5A880] p-1.5 cursor-pointer transition-all duration-200 group flex flex-col justify-between';
        card.innerHTML = `
          <div class="relative aspect-square rounded-lg overflow-hidden bg-black/40 mb-1 flex items-center justify-center">
            <img src="${m.public_url}" alt="${m.original_name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          </div>
          <div class="text-[10px] text-[#FAF7F2] truncate font-medium" title="${m.original_name}">${m.original_name}</div>
        `;
        card.addEventListener('click', () => selectItem(m));
        grid.appendChild(card);
      });
    }

    modalSearch?.addEventListener('input', () => renderGrid(cachedMedia));

    // Direct Upload Handler
    directUploadInput?.addEventListener('change', async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;

      uploadLabel.textContent = isRtl ? 'جاري الرفع...' : 'Uploading...';
      const formData = new FormData();
      formData.append('file', file);
      formData.append('title_ar', file.name);

      try {
        const res = await fetch('/api/admin/media/upload', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || (isRtl ? 'فشل الرفع' : 'Upload failed'));
        }

        const uploadedMedia = data.data;
        cachedMedia.unshift(uploadedMedia);
        selectItem(uploadedMedia);
      } catch (err) {
        alert(err.message);
      } finally {
        uploadLabel.textContent = isRtl ? 'رفع صورة جديدة' : 'Upload New';
        directUploadInput.value = '';
      }
    });
  })();
</script>
