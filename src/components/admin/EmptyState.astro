---
interface Props {
  title: string;
  description: string;
  icon?: string;
  actionText?: string;
  actionHref?: string;
  actionDisabled?: boolean;
  lang?: 'ar' | 'en';
}

const {
  title,
  description,
  icon = 'empty',
  actionText,
  actionHref,
  actionDisabled = false,
  lang = 'ar',
} = Astro.props;
---

<div class="rounded-2xl border border-dashed border-[#A87952]/30 bg-[#1C130D]/40 p-12 text-center flex flex-col items-center justify-center backdrop-blur-sm">
  <div class="w-16 h-16 rounded-2xl bg-[#38251F]/40 border border-[#C5A880]/20 flex items-center justify-center text-[#C5A880] mb-4 shadow-inner">
    <svg class="w-8 h-8 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
    </svg>
  </div>

  <h3 class="text-lg font-bold font-['Amiri',serif] text-[#FAF7F2] mb-2">
    {title}
  </h3>
  <p class="text-sm text-[#D8C4A3]/70 max-w-md font-light leading-relaxed mb-6">
    {description}
  </p>

  {actionText && (
    <div>
      {actionDisabled ? (
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-medium bg-[#38251F]/60 text-[#D8C4A3]/50 border border-[#A87952]/20 cursor-not-allowed">
          <span>{actionText}</span>
          <span class="text-[10px] bg-[#A87952]/20 text-[#C5A880] px-2 py-0.5 rounded">
            {lang === 'ar' ? 'المرحلة القادمة' : 'Upcoming Phase'}
          </span>
        </span>
      ) : (
        <a
          href={actionHref}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] transition-all shadow-md hover:shadow-lg shadow-[#A87952]/20"
        >
          <span>{actionText}</span>
        </a>
      )}
    </div>
  )}
</div>
