---
import type { AdminUserLocal } from '../../server/auth/rbac';

interface Props {
  user: AdminUserLocal;
  requiredPermission?: string;
  lang?: 'ar' | 'en';
}

const {
  user,
  requiredPermission,
  lang = 'ar',
} = Astro.props;

const isRtl = lang === 'ar';
---

<div class="min-h-[60vh] flex items-center justify-center p-6">
  <div class="max-w-lg w-full rounded-2xl bg-gradient-to-b from-[#241814] to-[#1C130D] border border-red-500/30 p-8 sm:p-10 text-center shadow-2xl relative overflow-hidden">
    <!-- Atmospheric subtle red/bronze warning glow -->
    <div class="absolute -top-20 -right-20 w-48 h-48 rounded-full bg-red-900/10 blur-3xl pointer-events-none"></div>

    <div class="w-16 h-16 rounded-2xl bg-red-950/40 border border-red-500/40 flex items-center justify-center text-red-400 mx-auto mb-6 shadow-inner">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>

    <span class="inline-block px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider bg-red-950/60 border border-red-500/30 text-red-300 mb-3 uppercase">
      {isRtl ? 'خطأ في الصلاحيات (403 Forbidden)' : 'Access Restricted (403 Forbidden)'}
    </span>

    <h2 class="text-2xl font-bold font-['Amiri',serif] text-[#FAF7F2] mb-3">
      {isRtl ? 'غير مصرح لك بالوصول إلى هذا القسم' : 'You do not have access to this section'}
    </h2>

    <p class="text-sm text-[#D8C4A3]/80 leading-relaxed font-light mb-6">
      {isRtl
        ? `حسابك الإداري الحالي (${user.roleSlug}) لا يمتلك الصلاحية المطلوبة للوصول إلى هذه البيانات أو تنفيذ إجراءات ضمن هذا المسار.`
        : `Your current administrator role (${user.roleSlug}) lacks the necessary privileges required to access this resource.`}
    </p>

    {requiredPermission && (
      <div class="p-3.5 rounded-xl bg-[#140D09]/80 border border-[#A87952]/20 mb-6 text-xs text-start">
        <div class="flex items-center justify-between mb-1">
          <span class="text-[#D8C4A3]/60">{isRtl ? 'الصلاحية المطلوبة:' : 'Required Permission:'}</span>
          <code class="text-red-400 font-mono bg-red-950/40 px-2 py-0.5 rounded border border-red-900/30">{requiredPermission}</code>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[#D8C4A3]/60">{isRtl ? 'صلاحيات حسابك:' : 'Your Role:'}</span>
          <span class="text-[#C5A880] font-medium">{user.roleSlug}</span>
        </div>
      </div>
    )}

    <a
      href="/admin"
      class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] transition-all shadow-md shadow-[#A87952]/20"
    >
      <svg class={`w-4 h-4 ${isRtl ? 'rotate-180' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>{isRtl ? 'العودة إلى لوحة التحكم الرئيسية' : 'Return to Dashboard Overview'}</span>
    </a>
  </div>
</div>
