---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { faqItems } from '../../data/faq';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="faq" class="relative py-20 sm:py-28 bg-ivory-100/60 overflow-hidden" aria-labelledby="faq-heading">
  <!-- Subtle decorative background glow -->
  <div class="absolute -top-32 start-1/2 -translate-x-1/2 w-[40rem] h-[25rem] bg-champagne-300/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-14 sm:mb-16">
      <div class="inline-flex items-center gap-2 rounded-pill border border-bronze-300/40 bg-ivory-50 px-4 py-1.5 mb-4 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-bronze-500"></span>
        <span class="text-caption sm:text-body-sm font-medium tracking-widest text-bronze-700 uppercase">
          {t('faq.eyebrow')}
        </span>
      </div>

      <h2 id="faq-heading" class="font-heading text-2xl sm:text-4xl lg:text-5xl font-bold text-chocolate-900 leading-tight mb-4">
        {t('faq.title')}
      </h2>

      <p class="mx-auto max-w-2xl text-body sm:text-body-lg text-chocolate-700/80 leading-relaxed">
        {t('faq.subtitle')}
      </p>

      <div class="mx-auto mt-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 sm:w-16 bg-gradient-to-r from-transparent to-bronze-400"></span>
        <span class="h-2 w-2 rotate-45 border border-bronze-400 bg-bronze-500"></span>
        <span class="h-px w-10 sm:w-16 bg-gradient-to-l from-transparent to-bronze-400"></span>
      </div>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      {faqItems.map((faq, index) => (
        <details
          class="group rounded-2xl border border-bronze-200/70 bg-ivory-50/90 p-5 sm:p-6 transition-all duration-300 ease-elegant hover:border-bronze-400/80 hover:shadow-card open:bg-ivory-50 open:border-bronze-400 open:shadow-elevated"
          open={index === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-body-lg sm:text-xl font-bold text-chocolate-900 transition-colors group-hover:text-bronze-700 focus:outline-none">
            <span class="flex items-center gap-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-bronze-100 text-caption font-bold text-bronze-700">
                0{index + 1}
              </span>
              <span>{faq.q[lang]}</span>
            </span>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-bronze-50 text-bronze-600 transition-transform duration-300 group-open:rotate-180">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-bronze-100/80 text-body sm:text-body-lg text-chocolate-700 leading-relaxed">
            <p>{faq.a[lang]}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
