---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { servicesData } from '../../data/services';
import ServiceCard from '../ui/ServiceCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="services" class="py-24 sm:py-32 bg-ivory-100/60 relative overflow-hidden">
  <!-- Subtle top and bottom border accents -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-champagne-300 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-champagne-300 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="h-px w-6 bg-bronze-500"></span>
        <span class="text-caption sm:text-body-sm font-semibold tracking-widest text-bronze-600 uppercase">
          {t('services.eyebrow')}
        </span>
        <span class="h-px w-6 bg-bronze-500"></span>
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-chocolate-800 leading-tight mb-5">
        {t('services.title')}
      </h2>

      <!-- Diamond divider -->
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="h-px w-12 bg-bronze-400/40"></span>
        <span class="h-1.5 w-1.5 rotate-45 bg-bronze-500"></span>
        <span class="h-px w-12 bg-bronze-400/40"></span>
      </div>

      <p class="text-body sm:text-body-lg text-chocolate-600 leading-relaxed">
        {t('services.subtitle')}
      </p>
    </div>

    <!-- 6 Signature Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-9">
      {servicesData.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>

    <!-- Footer Note / Customized Treatments -->
    <div class="mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 sm:gap-6 rounded-2xl bg-white border border-champagne-200/80 px-6 py-4 shadow-soft">
        <div class="flex items-center gap-2 text-bronze-600 font-semibold text-body-sm">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
          <span>{lang === 'ar' ? 'جلسات مخصصة حسب رغبتكِ' : 'Customized Rituals Available'}</span>
        </div>
        <span class="hidden sm:block h-4 w-px bg-champagne-300"></span>
        <p class="text-caption sm:text-body-sm text-chocolate-500">
          {lang === 'ar'
            ? 'يمكنكِ دمج أكثر من خدمة في جلسة واحدة بالتنسيق مع أخصائياتنا عند الحجز.'
            : 'Combine multiple signature treatments in one session by consulting our therapists.'}
        </p>
      </div>
    </div>

  </div>
</section>
