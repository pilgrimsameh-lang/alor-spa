---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-chocolate-950 pt-20"
>
  <!-- Background Image with Luxury Treatment -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/hero-bg.jpg"
      alt={lang === 'ar' ? 'أجواء الاسترخاء والسكينة الفاخرة في ألور سبا الرياض' : 'ALOR SPA Luxury Sanctuary Ambiance in Riyadh'}
      width="1920"
      height="1280"
      class="h-full w-full object-cover object-center scale-105 animate-fade-in filter brightness-[0.75] contrast-[1.05]"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Multi-layered editorial gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-chocolate-950 via-chocolate-950/75 to-chocolate-950/85"></div>
    <div class="absolute inset-0 bg-radial-[circle_at_center] from-transparent via-chocolate-950/40 to-chocolate-950/90"></div>
  </div>

  <!-- Decorative subtle background aura -->
  <div class="absolute -top-24 start-1/2 -translate-x-1/2 w-[35rem] h-[35rem] bg-bronze-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Main Hero Content -->
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
    
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2.5 rounded-pill border border-bronze-400/30 bg-chocolate-900/60 backdrop-blur-md px-5 py-2 mb-8 animate-fade-down">
      <span class="h-1.5 w-1.5 rounded-full bg-bronze-400 animate-pulse"></span>
      <span class="text-caption sm:text-body-sm font-medium tracking-widest text-champagne-200 uppercase">
        {t('hero.eyebrow')}
      </span>
      <span class="h-1.5 w-1.5 rounded-full bg-bronze-400 animate-pulse"></span>
    </div>

    <!-- Main Headline -->
    <h1 class="mb-6 font-heading text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.15] text-ivory-50 tracking-tight max-w-4xl mx-auto animate-fade-up">
      {t('hero.title')}
    </h1>

    <!-- Decorative Diamond Separator -->
    <div class="mx-auto mb-8 flex items-center justify-center gap-3">
      <span class="h-px w-10 sm:w-16 bg-gradient-to-r from-transparent to-bronze-400/60"></span>
      <span class="h-2 w-2 rotate-45 border border-bronze-400 bg-bronze-500/80"></span>
      <span class="h-px w-10 sm:w-16 bg-gradient-to-l from-transparent to-bronze-400/60"></span>
    </div>

    <!-- Editorial Description -->
    <p class="mx-auto mb-10 max-w-2xl text-body sm:text-body-lg text-ivory-200/90 leading-relaxed font-normal animate-fade-up delay-100">
      {t('hero.description')}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-16 animate-fade-up delay-200">
      <WhatsAppButton
        variant="primary"
        size="lg"
        label={t('hero.cta.book')}
        class="w-full sm:w-auto shadow-elevated"
      />

      <a
        href="#services"
        class="group inline-flex items-center justify-center gap-2 rounded-pill border border-champagne-300/30 bg-chocolate-900/40 backdrop-blur-sm px-8 py-4 text-body font-medium text-ivory-100 transition-all duration-300 ease-elegant hover:border-bronze-400 hover:bg-chocolate-800/60 hover:text-bronze-300 w-full sm:w-auto"
      >
        <span>{t('hero.cta.explore')}</span>
        <svg class="h-4 w-4 rtl:rotate-180 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <!-- Editorial Pillars Strip -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 pt-8 border-t border-champagne-300/15 max-w-4xl mx-auto text-start sm:text-center">
      <div class="flex items-center sm:justify-center gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-bronze-500/20 text-bronze-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <span class="text-body-sm font-medium text-ivory-200">
          {lang === 'ar' ? 'ملاذ نسائي خاص بالكامل' : '100% Women Only Sanctuary'}
        </span>
      </div>

      <div class="flex items-center sm:justify-center gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-bronze-500/20 text-bronze-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <span class="text-body-sm font-medium text-ivory-200">
          {lang === 'ar' ? 'أخصائيات خبيرات ومعتمدات' : 'Certified Female Therapists'}
        </span>
      </div>

      <div class="flex items-center sm:justify-center gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-bronze-500/20 text-bronze-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <span class="text-body-sm font-medium text-ivory-200">
          {lang === 'ar' ? 'مستخلصات وزيوت طبيعية نقية' : 'Pure Botanical Formulations'}
        </span>
      </div>
    </div>

  </div>

  <!-- Bottom Transition to Ivory Section -->
  <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ivory-50 to-transparent pointer-events-none"></div>
</section>
