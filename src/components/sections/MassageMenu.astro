---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { massageMenuCatalog } from '../../data/packages';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="massage-menu" class="py-24 sm:py-32 bg-chocolate-950 text-ivory-100 relative overflow-hidden">
  
  <!-- Subtle ambient decorative glow -->
  <div class="absolute -top-32 start-1/4 h-96 w-96 rounded-full bg-bronze-500/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 end-1/4 h-96 w-96 rounded-full bg-rosegold-500/10 blur-3xl pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="h-px w-6 bg-bronze-400"></span>
        <span class="text-caption sm:text-body-sm font-semibold tracking-widest text-bronze-300 uppercase">
          {t('massageMenu.eyebrow')}
        </span>
        <span class="h-px w-6 bg-bronze-400"></span>
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-ivory-50 leading-tight mb-5">
        {t('massageMenu.title')}
      </h2>

      <!-- Diamond divider -->
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="h-px w-12 bg-bronze-400/40"></span>
        <span class="h-1.5 w-1.5 rotate-45 bg-bronze-400"></span>
        <span class="h-px w-12 bg-bronze-400/40"></span>
      </div>

      <p class="text-body sm:text-body-lg text-ivory-300 leading-relaxed">
        {t('massageMenu.subtitle')}
      </p>
    </div>

    <!-- 6 Massage Types Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {massageMenuCatalog.map((item, index) => (
        <div class="rounded-card bg-chocolate-900/90 border border-bronze-500/30 p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:border-bronze-400 hover:shadow-elevated">
          <div>
            <!-- Header Tag & Number -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-caption font-semibold tracking-wider text-champagne-300 uppercase">
                {lang === 'ar' ? `النوع 0${index + 1}` : `Type 0${index + 1}`}
              </span>
              <span class="h-2 w-2 rounded-full bg-bronze-400"></span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="font-heading text-xl sm:text-2xl font-bold text-ivory-50 mb-2">
              {item.title[lang]}
            </h3>
            {item.subtitle && (
              <p class="text-caption sm:text-body-sm text-champagne-300/90 mb-3">
                {item.subtitle[lang]}
              </p>
            )}

            <!-- Description -->
            <p class="text-body-sm text-ivory-300 leading-relaxed mb-6">
              {item.description[lang]}
            </p>
          </div>

          <!-- Durations & Pricing Table / Options -->
          <div class="space-y-2.5 pt-4 border-t border-bronze-500/20">
            <p class="text-[11px] font-semibold text-champagne-300 uppercase tracking-wider mb-2">
              {lang === 'ar' ? 'المدد والأسعار المعتمدة:' : 'Curated Durations & Pricing:'}
            </p>
            
            {item.variants.map((v) => (
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-chocolate-950/60 border border-bronze-500/20 hover:border-bronze-400 transition-colors">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-bronze-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-body-sm font-medium text-ivory-200">
                    {v.durationDisplay[lang]}
                  </span>
                </div>
                
                <div class="flex items-center gap-3">
                  <span class="font-heading text-body-sm font-bold text-champagne-200">
                    {v.priceDisplay[lang]}
                  </span>
                  
                  <WhatsAppButton
                    serviceName={`${item.title[lang]} (${v.durationDisplay[lang]})`}
                    variant="compact"
                    size="sm"
                    label={lang === 'ar' ? 'حجز' : 'Book'}
                    class="!px-3 !py-1 !text-caption !bg-bronze-500 text-ivory-50 hover:!bg-bronze-400"
                    showIcon={false}
                  />
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

    <!-- Assurance Note -->
    <div class="mt-12 text-center">
      <p class="text-caption text-champagne-300/80">
        {lang === 'ar'
          ? '* جميع الأسعار بالريال السعودي وتشمل ضريبة القيمة المضافة، وتُقدم كل جلسة بأعلى معايير الخصوصية.'
          : '* All rates are in Saudi Riyals (SAR) inclusive of VAT, delivered in absolute feminine privacy.'}
      </p>
    </div>

  </div>
</section>
