---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getDb } from '../../server/db/index';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import { DEMO_GUESTBOOK_REVIEWS } from '../../data/demo-reviews';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isRtl = lang === 'ar';

// Fetch approved reviews from SQLite database, combined with the 20 guest impressions
let dbReviews: Array<{
  id: string;
  author_name: string;
  author_title_ar: string | null;
  author_title_en: string | null;
  quote_ar: string;
  quote_en: string;
  rating: number;
  is_verified: number;
}> = [];

try {
  const { client } = getDb();
  const res = await client.execute(`
    SELECT id, author_name, author_title_ar, author_title_en, quote_ar, quote_en, rating, is_verified
    FROM reviews
    WHERE is_approved = 1 AND id NOT LIKE 'demo_%'
    ORDER BY display_order ASC, created_at DESC;
  `);
  dbReviews = res.rows as any;
} catch (e) {
  dbReviews = [];
}

// Map the 20 guestbook reviews to display on the impressions page
const guestbookReviews = DEMO_GUESTBOOK_REVIEWS.map((item) => ({
  id: item.id,
  author_name: item.name,
  author_title_ar: item.topicAr,
  author_title_en: item.topicEn,
  quote_ar: item.quoteAr,
  quote_en: item.quoteEn,
  rating: item.rating,
  is_verified: 1,
}));

// Combine: real approved database reviews + the 20 guest impressions
const approvedReviews = [...dbReviews, ...guestbookReviews];
---

<section id="testimonials" class="py-24 sm:py-32 bg-ivory-100/70 relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="h-px w-6 bg-bronze-500"></span>
        <span class="text-caption sm:text-body-sm font-semibold tracking-widest text-bronze-600 uppercase">
          {t('testimonials.eyebrow')}
        </span>
        <span class="h-px w-6 bg-bronze-500"></span>
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-chocolate-800 leading-tight mb-5">
        {t('testimonials.title')}
      </h2>

      <!-- Diamond divider -->
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="h-px w-12 bg-bronze-400/40"></span>
        <span class="h-1.5 w-1.5 rotate-45 bg-bronze-500"></span>
        <span class="h-px w-12 bg-bronze-400/40"></span>
      </div>

      <p class="text-body sm:text-body-lg text-chocolate-600 leading-relaxed">
        {t('testimonials.subtitle')}
      </p>
    </div>

    <!-- Approved Reviews Grid or Refined Invitation State -->
    {approvedReviews.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {approvedReviews.map((item) => (
          <div class="rounded-card bg-white p-8 shadow-soft border border-champagne-200 flex flex-col justify-between hover:shadow-card transition-shadow duration-300">
            <div>
              <!-- Star Rating -->
              <div class="flex items-center gap-1 mb-4 text-[#C5A880]" aria-label={`${item.rating} out of 5 stars`}>
                {[1, 2, 3, 4, 5].map((star) => (
                  <svg
                    class:list={[
                      'w-4 h-4',
                      star <= item.rating ? 'text-[#C5A880] fill-[#C5A880]' : 'text-stone-300 fill-transparent'
                    ]}
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                  </svg>
                ))}
              </div>

              <!-- Comment Quote -->
              <p class="text-body text-chocolate-700 italic leading-relaxed mb-6">
                “{lang === 'ar' ? (item.quote_ar || item.quote_en) : (item.quote_en || item.quote_ar)}”
              </p>
            </div>

            <!-- Author & Verified Status -->
            <div class="flex items-center justify-between border-t border-champagne-200/60 pt-4">
              <div>
                <h4 class="font-heading font-bold text-chocolate-800">{item.author_name}</h4>
                <p class="text-caption text-bronze-500">
                  {lang === 'ar' ? (item.author_title_ar || 'ضيفة ألور سبا') : (item.author_title_en || 'ALOR SPA Guest')}
                </p>
              </div>
              {item.is_verified === 1 && (
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  {lang === 'ar' ? 'زيارة موثقة' : 'Verified'}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="max-w-3xl mx-auto rounded-3xl bg-white border border-champagne-200/90 p-8 sm:p-12 shadow-card text-center relative mb-16">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-champagne-100 text-bronze-500">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
          </svg>
        </div>

        <span class="inline-block px-3.5 py-1 rounded-pill bg-bronze-50 text-bronze-700 text-caption font-semibold tracking-wider mb-4 border border-bronze-200/60">
          {t('testimonials.emptyBadge')}
        </span>

        <h3 class="font-heading text-2xl sm:text-3xl font-bold text-chocolate-800 mb-4">
          {t('testimonials.emptyTitle')}
        </h3>

        <p class="text-body text-chocolate-600 leading-relaxed mb-8 max-w-xl mx-auto">
          {t('testimonials.emptyDesc')}
        </p>

        <div class="pt-6 border-t border-champagne-200/60 flex flex-col sm:flex-row items-center justify-center gap-4">
          <WhatsAppButton
            variant="primary"
            size="md"
            label={lang === 'ar' ? 'كوني أول من يشاركنا التجربة' : 'Be Among Our First Guests'}
          />
        </div>
      </div>
    )}

    <!-- Review Submission Section: «ضيفي رأيك وتقييمك» -->
    <div class="max-w-2xl mx-auto rounded-3xl bg-white border border-champagne-200 p-8 sm:p-10 shadow-card">
      <div class="text-center mb-6">
        <h3 class="font-heading text-2xl sm:text-3xl font-bold text-chocolate-800 mb-2">
          {t('testimonials.formTitle')}
        </h3>
        <p class="text-body-sm text-chocolate-500 leading-relaxed">
          {t('testimonials.formSubtitle')}
        </p>
      </div>

      <!-- Success Notification Alert -->
      <div id="review-success-alert" class="hidden mb-6 p-5 rounded-2xl bg-champagne-50 border border-bronze-300 text-center animate-fade-in space-y-2">
        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <h4 class="font-heading text-lg font-bold text-chocolate-800">
          {lang === 'ar' ? 'شكرًا جزيلاً لمشاركتكِ الكريمة 🌸' : 'Thank You for Your Feedback 🌸'}
        </h4>
        <p class="text-body-sm text-chocolate-600">
          {lang === 'ar'
            ? 'تم استلام تقييمكِ بنجاح، وبانتظار اعتماده من إدارة السبا قبل نشره على الموقع.'
            : 'Your review has been successfully submitted and is awaiting management review prior to publishing.'}
        </p>
      </div>

      <!-- Error Notification Alert -->
      <div id="review-error-alert" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-medium"></div>

      <!-- Review Form -->
      <form id="public-review-form" class="space-y-5">
        <!-- Client Name -->
        <div>
          <label for="review-author" class="field-label font-medium text-body-sm text-chocolate-700">
            {t('testimonials.formName')} <span class="text-bronze-500">*</span>
          </label>
          <input
            type="text"
            id="review-author"
            name="name"
            required
            minlength="2"
            maxlength="100"
            placeholder={lang === 'ar' ? 'نورة العتيبي' : 'Noura Al-Otaibi'}
            class="field"
          />
        </div>

        <!-- Star Rating Picker (1 to 5 Stars) -->
        <div>
          <label class="field-label font-medium text-body-sm text-chocolate-700 block mb-2">
            {t('testimonials.formRating')} <span class="text-bronze-500">*</span>
          </label>
          <div class="flex items-center gap-2" id="star-rating-container" role="radiogroup" aria-label="Rating">
            {[1, 2, 3, 4, 5].map((star) => (
              <button
                type="button"
                data-star-val={star}
                class="star-pick-btn p-1 text-[#C5A880] hover:scale-110 transition-transform cursor-pointer focus:outline-none"
                aria-label={`${star} star${star > 1 ? 's' : ''}`}
              >
                <svg class="w-8 h-8 fill-[#C5A880] text-[#C5A880]" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
              </button>
            ))}
            <input type="hidden" name="rating" id="selected-rating-value" value="5" />
            <span class="text-caption font-semibold text-bronze-600 px-2" id="rating-label-display">5 / 5</span>
          </div>
        </div>

        <!-- Review Comment / Opinion -->
        <div>
          <label for="review-quote" class="field-label font-medium text-body-sm text-chocolate-700">
            {t('testimonials.formComment')} <span class="text-bronze-500">*</span>
          </label>
          <textarea
            id="review-quote"
            name="quote"
            required
            rows="4"
            minlength="5"
            maxlength="1000"
            placeholder={lang === 'ar' ? 'شاركينا انطباعكِ عن جودة الخدمات، النظافة، الاستقبال، وأجواء الاسترخاء...' : 'Share your thoughts regarding our service quality, ambiance, hospitality, and relaxation...'}
            class="field"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="review-submit-btn"
          class="btn btn-primary w-full py-4 text-body font-semibold cursor-pointer shadow-soft hover:shadow-card active:scale-[0.99] flex items-center justify-center gap-2"
        >
          <span id="review-submit-label">{t('testimonials.formSubmit')}</span>
          <svg class="h-4 w-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>

        <p class="text-caption text-center text-chocolate-400">
          {lang === 'ar'
            ? 'تخضع جميع التقييمات للمراجعة المسبقة من إدارة السبا للحفاظ على المصداقية والخصوصية.'
            : 'All reviews are moderated by ALOR SPA management to uphold authenticity and confidentiality.'}
        </p>
      </form>
    </div>

  </div>
</section>

<script>
  function setupTestimonials() {
    const form = document.getElementById('public-review-form') as HTMLFormElement | null;
    const starBtns = document.querySelectorAll('.star-pick-btn');
    const ratingInput = document.getElementById('selected-rating-value') as HTMLInputElement | null;
    const ratingLabel = document.getElementById('rating-label-display');
    const successAlert = document.getElementById('review-success-alert');
    const errorAlert = document.getElementById('review-error-alert');
    const submitBtn = document.getElementById('review-submit-btn') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('review-submit-label');

    if (!form) return;

    let currentRating = 5;

    function updateStarsDisplay(rating: number) {
      starBtns.forEach((btn, idx) => {
        const svg = btn.querySelector('svg');
        if (svg) {
          if (idx < rating) {
            svg.classList.add('fill-[#C5A880]', 'text-[#C5A880]');
            svg.classList.remove('fill-transparent', 'text-stone-300');
          } else {
            svg.classList.remove('fill-[#C5A880]', 'text-[#C5A880]');
            svg.classList.add('fill-transparent', 'text-stone-300');
          }
        }
      });
      if (ratingLabel) {
        ratingLabel.textContent = `${rating} / 5`;
      }
      if (ratingInput) {
        ratingInput.value = String(rating);
      }
    }

    starBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = parseInt(btn.getAttribute('data-star-val') || '5', 10);
        currentRating = val;
        updateStarsDisplay(val);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) {
        errorAlert.textContent = '';
        errorAlert.classList.add('hidden');
      }

      const formData = new FormData(form);
      const name = (formData.get('name') as string)?.trim() || '';
      const quote = (formData.get('quote') as string)?.trim() || '';
      const rating = currentRating;

      const isAr = document.documentElement.lang !== 'en';

      if (!name || name.length < 2) {
        if (errorAlert) {
          errorAlert.textContent = isAr ? 'يرجى كتابة الاسم بشكل صحيح (حرفين على الأقل)' : 'Please enter a valid name';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      if (!quote || quote.length < 5) {
        if (errorAlert) {
          errorAlert.textContent = isAr ? 'يرجى كتابة تعليقكِ بوضوح (5 أحرف على الأقل)' : 'Please write your feedback (at least 5 characters)';
          errorAlert.classList.remove('hidden');
        }
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = isAr ? 'جاري الإرسال...' : 'Submitting...';

      try {
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, quote, rating }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.error || (isAr ? 'حدث خطأ أثناء إرسال التقييم' : 'Failed to submit review'));
        }

        form.reset();
        currentRating = 5;
        updateStarsDisplay(5);
        if (successAlert) {
          successAlert.classList.remove('hidden');
          successAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch (err: any) {
        if (errorAlert) {
          errorAlert.textContent = err.message || (isAr ? 'تعذر إرسال التقييم حالياً، يرجى المحاولة لاحقاً.' : 'Error submitting review, please try again.');
          errorAlert.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = isAr ? 'إرسال التقييم' : 'Submit Review';
      }
    });
  }

  setupTestimonials();
  document.addEventListener('astro:after-swap', setupTestimonials);
</script>
