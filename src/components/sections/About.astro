---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  {
    title: t('about.pillar1.title'),
    desc: t('about.pillar1.desc'),
    icon: 'M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z',
  },
  {
    title: t('about.pillar2.title'),
    desc: t('about.pillar2.desc'),
    icon: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
  },
  {
    title: t('about.pillar3.title'),
    desc: t('about.pillar3.desc'),
    icon: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 003 12c0-1.605.42-3.113 1.157-4.418',
  },
  {
    title: t('about.pillar4.title'),
    desc: t('about.pillar4.desc'),
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
  },
];
---

<section id="about" class="py-24 sm:py-32 bg-ivory-50 relative overflow-hidden">
  
  <!-- Subtle decorative ambient elements -->
  <div class="absolute -top-32 -start-32 h-96 w-96 rounded-full bg-champagne-100/60 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -end-32 h-96 w-96 rounded-full bg-bronze-100/40 blur-3xl pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Narrative Column (7 cols on lg) -->
      <div class="lg:col-span-7">
        
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="h-px w-6 bg-bronze-500"></span>
          <span class="text-caption sm:text-body-sm font-semibold tracking-widest text-bronze-600 uppercase">
            {t('about.eyebrow')}
          </span>
        </div>

        <!-- Section Title -->
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-chocolate-800 leading-tight mb-6">
          {t('about.title')}
        </h2>

        <!-- Diamond Divider -->
        <div class="flex items-center gap-3 mb-8">
          <span class="h-px w-12 bg-bronze-400/40"></span>
          <span class="h-1.5 w-1.5 rotate-45 bg-bronze-500"></span>
          <span class="h-px w-12 bg-bronze-400/40"></span>
        </div>

        <!-- Lead Paragraph -->
        <p class="font-heading text-body-lg sm:text-xl text-chocolate-700 font-medium leading-relaxed mb-6">
          {t('about.lead')}
        </p>

        <!-- Body Text -->
        <div class="space-y-4 text-chocolate-600 text-body leading-relaxed mb-10">
          <p>{t('about.p1')}</p>
          <p>{t('about.p2')}</p>
        </div>

        <!-- 4 Pillars Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-6 border-t border-champagne-300/40">
          {pillars.map((pillar) => (
            <div class="flex items-start gap-3.5 p-3.5 rounded-card bg-ivory-100/80 border border-champagne-200/60 transition-all duration-300 hover:border-bronze-300 hover:shadow-soft">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bronze-100 text-bronze-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d={pillar.icon} />
                </svg>
              </span>
              <div>
                <h3 class="font-heading text-body font-semibold text-chocolate-800 mb-1">
                  {pillar.title}
                </h3>
                <p class="text-body-sm text-chocolate-500 leading-relaxed">
                  {pillar.desc}
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Editorial Visual Column (5 cols on lg) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Decorative frame border -->
          <div class="absolute -inset-3 sm:-inset-4 rounded-2xl border-2 border-champagne-300/40 translate-x-2 translate-y-2 pointer-events-none"></div>

          <!-- Main Ambiance Image -->
          <div class="relative rounded-xl overflow-hidden shadow-elevated bg-chocolate-900 aspect-[4/5]">
            <img
              src="/images/about/about-ambiance.jpg"
              alt={lang === 'ar' ? 'أجواء أجنحة العناية والمساج الهادئة في ألور سبا بالرياض' : 'Serene massage & wellness ambiance at ALOR SPA Riyadh'}
              width="1000"
              height="667"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-chocolate-950/60 via-transparent to-transparent"></div>
          </div>

          <!-- Overlapping Secondary Image -->
          <div class="absolute -bottom-8 -start-6 sm:-start-10 w-44 sm:w-56 rounded-xl overflow-hidden border-4 border-ivory-50 shadow-elevated aspect-[4/3] bg-chocolate-800 hidden xs:block">
            <img
              src="/images/about/about-detail.jpg"
              alt={lang === 'ar' ? 'مستخلصات الزيوت العطرية والمكونات الطبيعية الفاخرة في ألور سبا الرياض' : 'Pure botanical formulations and aromatherapy oils at ALOR SPA Riyadh'}
              width="800"
              height="533"
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Floating Ethos Badge -->
          <div class="absolute -top-4 -end-4 sm:-end-6 rounded-card bg-chocolate-900/90 backdrop-blur-md border border-bronze-400/40 px-4 py-3 shadow-card text-ivory-50">
            <p class="text-caption font-bold tracking-widest text-bronze-400 uppercase">
              {lang === 'ar' ? 'ملاذ نسائي' : 'Women Only'}
            </p>
            <p class="font-heading text-body-sm font-medium text-ivory-100">
              {lang === 'ar' ? 'خصوصية تامة' : 'Absolute Privacy'}
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
