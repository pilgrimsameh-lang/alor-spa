---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Offers from '../../components/sections/Offers.astro';
import BackToHomeButton from '../../components/ui/BackToHomeButton.astro';
import WhatsAppButton from '../../components/ui/WhatsAppButton.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

const seoTitle = "Massage Offers in Riyadh & Women's Spa Packages | ALOR SPA";
const seoDescription = "Discover exclusive massage offers in Riyadh and luxury women's spa packages at ALOR SPA. Relaxing massage, Moroccan bath, and full pampering rituals tailored for you.";

const siteUrl = Astro.site?.toString() || 'https://alorspa.com';

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl.replace(/\/$/, '')}/en/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Offers & Packages',
      item: `${siteUrl.replace(/\/$/, '')}/en/offers`,
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/en/offers"
  alternatePath="/offers"
  structuredData={[breadcrumbSchema]}
>
  <Header />

  <main id="main-content" class="pt-24 sm:pt-28">
    <!-- Back to Home Navigation Bar -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <BackToHomeButton />
    </div>

    <!-- Curated Offers Section -->
    <Offers />
  </main>

  <Footer />

  <!-- Mobile Floating Quick-Booking Bar -->
  <aside class="fixed bottom-4 inset-x-4 z-30 sm:hidden" aria-label="Quick Booking">
    <div class="rounded-pill p-1 bg-chocolate-950/90 backdrop-blur-md border border-bronze-500/40 shadow-elevated">
      <WhatsAppButton
        variant="primary"
        size="md"
        label={t('common.bookViaWhatsApp')}
        class="w-full justify-center !py-3 shadow-none text-body-sm font-semibold"
      />
    </div>
  </aside>
</Layout>
