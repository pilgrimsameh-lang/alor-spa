---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import BackToHomeButton from '../../components/ui/BackToHomeButton.astro';
import WhatsAppButton from '../../components/ui/WhatsAppButton.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

const seoTitle = "Guest Reviews & Experiences | ALOR SPA Women's Massage Center Riyadh";
const seoDescription = "Read genuine reviews and testimonials from guests at ALOR SPA Riyadh. Discover experiences of our luxury women's massage, Moroccan hammam, and bespoke spa rituals.";

const siteUrl = Astro.site?.toString() || 'https://alorspa.com';

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl.replace(/\/$/, '')}/en/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guest Impressions',
      item: `${siteUrl.replace(/\/$/, '')}/en/testimonials`,
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/en/testimonials"
  alternatePath="/testimonials"
  structuredData={[breadcrumbSchema]}
>
  <Header />

  <main id="main-content" class="pt-24 sm:pt-28">
    <!-- Back to Home Navigation Bar -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <BackToHomeButton />
    </div>

    <!-- Guest Testimonials & Reviews Section -->
    <Testimonials />
  </main>

  <Footer />

  <!-- Mobile Floating Quick-Booking Bar -->
  <aside class="fixed bottom-4 inset-x-4 z-30 sm:hidden" aria-label="Quick Booking">
    <div class="rounded-pill p-1 bg-chocolate-950/90 backdrop-blur-md border border-bronze-500/40 shadow-elevated">
      <WhatsAppButton
        variant="primary"
        size="md"
        label={t('common.bookViaWhatsApp')}
        class="w-full justify-center !py-3 shadow-none text-body-sm font-semibold"
      />
    </div>
  </aside>
</Layout>
