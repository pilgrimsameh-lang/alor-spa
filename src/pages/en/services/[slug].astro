---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import ServiceDetailContent from '../../../components/services/ServiceDetailContent.astro';
import { servicesData, type ServiceItem } from '../../../data/services';
import { siteConfig, getSchemaTelephone, getSiteUrl } from '../../../config/site';

export function getStaticPaths() {
  return servicesData.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || getSiteUrl();
const fullImageUrl = new URL(service.image, siteUrl).toString();
const currentPath = `/en/services/${service.slug}`;
const alternatePath = `/services/${service.slug}`;
const telephone = getSchemaTelephone();

// Schema.org Service & BreadcrumbList Structured Data
const structuredData = [
  {
    '@type': 'Service',
    '@id': `${siteUrl}${currentPath}#service`,
    name: service.title.en,
    alternateName: service.title.ar,
    serviceType: 'Luxury Spa & Wellness Treatment',
    description: service.description.en,
    image: fullImageUrl,
    url: `${siteUrl}${currentPath}`,
    provider: {
      '@type': ['BeautySalon', 'DaySpa'],
      '@id': `${siteUrl}/#organization`,
      name: 'ALOR SPA',
      url: siteUrl,
      ...(telephone ? { telephone } : {}),
      priceRange: '$$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Riyadh',
        addressCountry: 'SA',
      },
    },
    areaServed: {
      '@type': 'City',
      name: 'Riyadh',
    },
    offers: {
      '@type': 'Offer',
      price: service.price.isConfirmed ? service.price.amount : undefined,
      priceCurrency: 'SAR',
      availability: 'https://schema.org/InStock',
      url: `${siteUrl}${currentPath}`,
      description: service.price.isConfirmed
        ? `${service.price.display.en} - ${service.price.note?.en || ''}`
        : 'Pricing and duration confirmed upon inquiry',
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${siteUrl}${currentPath}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteUrl}/en/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: `${siteUrl}/en/services`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.title.en,
        item: `${siteUrl}${currentPath}`,
      },
    ],
  },
];
---

<Layout
  title={service.seo.title.en}
  description={service.seo.description.en}
  ogImage={service.image}
  canonicalPath={currentPath}
  alternatePath={alternatePath}
  structuredData={structuredData}
>
  <Header />

  <main id="main-content">
    <ServiceDetailContent service={service} />
  </main>

  <Footer />
</Layout>
