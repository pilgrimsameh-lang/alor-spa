---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Gallery from '../components/sections/Gallery.astro';
import BackToHomeButton from '../components/ui/BackToHomeButton.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ar');

const seoTitle = 'معرض صور ألور سبا | صور مركز سبا ومساج نسائي بالرياض — ALOR SPA';
const seoDescription = 'جولة مصورة في ألور سبا، أفضل مركز سبا ومساج نسائي بالرياض: استكشفي أجنحة المساج الفاخرة، غرف الحمام المغربي، ومرافق العناية والاسترخاء المصممة بأعلى معايير الخصوصية.';

const siteUrl = Astro.site?.toString() || 'https://alorspa.com';

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'الرئيسية',
      item: `${siteUrl.replace(/\/$/, '')}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'معرض الصور',
      item: `${siteUrl.replace(/\/$/, '')}/gallery`,
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/gallery"
  alternatePath="/en/gallery"
  structuredData={[breadcrumbSchema]}
>
  <Header />

  <main id="main-content" class="pt-24 sm:pt-28">
    <!-- Back to Home Navigation Bar -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <BackToHomeButton />
    </div>

    <!-- Sanctuary Gallery Section -->
    <Gallery />
  </main>

  <Footer />

  <!-- Mobile Floating Quick-Booking Bar -->
  <aside class="fixed bottom-4 inset-x-4 z-30 sm:hidden" aria-label="حجز سريع">
    <div class="rounded-pill p-1 bg-chocolate-950/90 backdrop-blur-md border border-bronze-500/40 shadow-elevated">
      <WhatsAppButton
        variant="primary"
        size="md"
        label={t('common.bookViaWhatsApp')}
        class="w-full justify-center !py-3 shadow-none text-body-sm font-semibold"
      />
    </div>
  </aside>
</Layout>
