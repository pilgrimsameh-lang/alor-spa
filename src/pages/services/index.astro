---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ServicesCatalog from '../../components/services/ServicesCatalog.astro';
import { servicesData } from '../../data/services';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('ar');

// SEO Title & Description
const seoTitle = 'خدمات المساج والسبا النسائي بالرياض | ألور سبا — ALOR SPA';
const seoDescription = 'استكشفي خدمات المساج والسبا النسائي في الرياض لدى ألور سبا: مساج استرخائي، مساج علاجي، مساج الأحجار الساخنة، حمام مغربي، وبدكير ومنكير بأعلى معايير الخصوصية.';

// Schema.org ItemList & BreadcrumbList Structured Data
const siteUrl = Astro.site?.toString() || 'https://alorspa.com';
const itemListSchema = {
  '@type': 'ItemList',
  name: 'قائمة خدمات ألور سبا الرياض',
  description: seoDescription,
  numberOfItems: servicesData.length,
  itemListElement: servicesData.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.title.ar,
    description: service.description.ar,
    url: `${siteUrl.replace(/\/$/, '')}/services/${service.slug}`,
    image: `${siteUrl.replace(/\/$/, '')}${service.image}`,
  })),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'الرئيسية',
      item: `${siteUrl.replace(/\/$/, '')}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'خدماتنا',
      item: `${siteUrl.replace(/\/$/, '')}/services`,
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/services"
  alternatePath="/en/services"
  structuredData={[itemListSchema, breadcrumbSchema]}
>
  <Header />
  
  <main id="main-content">
    <ServicesCatalog />
  </main>

  <Footer />
</Layout>
