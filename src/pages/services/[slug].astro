---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ServiceDetailContent from '../../components/services/ServiceDetailContent.astro';
import { servicesData, type ServiceItem } from '../../data/services';
import { siteConfig, getSchemaTelephone, getSiteUrl } from '../../config/site';

export function getStaticPaths() {
  return servicesData.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || getSiteUrl();
const fullImageUrl = new URL(service.image, siteUrl).toString();
const currentPath = `/services/${service.slug}`;
const alternatePath = `/en/services/${service.slug}`;
const telephone = getSchemaTelephone();

// Schema.org Service & BreadcrumbList Structured Data
const structuredData = [
  {
    '@type': 'Service',
    '@id': `${siteUrl}${currentPath}#service`,
    name: service.title.ar,
    alternateName: service.title.en,
    serviceType: 'Luxury Spa & Wellness Treatment',
    description: service.description.ar,
    image: fullImageUrl,
    url: `${siteUrl}${currentPath}`,
    provider: {
      '@type': ['BeautySalon', 'DaySpa'],
      '@id': `${siteUrl}/#organization`,
      name: 'ألور سبا',
      url: siteUrl,
      ...(telephone ? { telephone } : {}),
      priceRange: '$$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Riyadh',
        addressCountry: 'SA',
      },
    },
    areaServed: {
      '@type': 'City',
      name: 'الرياض',
    },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'SAR',
      availability: 'https://schema.org/InStock',
      description: 'يتم تحديد وتأكيد السعر بدقة عند التواصل وحجز الموعد',
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${siteUrl}${currentPath}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'الرئيسية',
        item: `${siteUrl}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'خدماتنا',
        item: `${siteUrl}/services`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.title.ar,
        item: `${siteUrl}${currentPath}`,
      },
    ],
  },
];
---

<Layout
  title={service.seo.title.ar}
  description={service.seo.description.ar}
  ogImage={service.image}
  canonicalPath={currentPath}
  alternatePath={alternatePath}
  structuredData={structuredData}
>
  <Header />

  <main id="main-content">
    <ServiceDetailContent service={service} />
  </main>

  <Footer />
</Layout>
