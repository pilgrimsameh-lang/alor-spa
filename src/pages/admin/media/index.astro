---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../server/db/index';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const queryLang = Astro.url.searchParams.get('lang');
const cookieLang = Astro.cookies.get('alor_admin_lang')?.value;
const lang: 'ar' | 'en' = (queryLang === 'en' || (!queryLang && cookieLang === 'en')) ? 'en' : 'ar';
const isRtl = lang === 'ar';

const { client } = getDb();

// Fetch media files and calculate usage counts in a single query
const mediaRes = await client.execute(`
  SELECT 
    m.*,
    u.full_name as uploader_name,
    (
      (SELECT COUNT(*) FROM services WHERE featured_image_id = m.id) +
      (SELECT COUNT(*) FROM offers WHERE image_id = m.id) +
      (SELECT COUNT(*) FROM gallery_items WHERE media_id = m.id) +
      (SELECT COUNT(*) FROM blog_posts WHERE featured_image_id = m.id)
    ) as usage_count
  FROM media_files m
  LEFT JOIN admin_users u ON m.uploaded_by = u.id
  ORDER BY m.created_at DESC;
`);

const mediaFiles = mediaRes.rows;

function formatFileSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
}

const totalCount = mediaFiles.length;
const totalSize = mediaFiles.reduce((acc, curr) => acc + Number(curr.file_size || 0), 0);
const usedCount = mediaFiles.filter((m) => Number(m.usage_count) > 0).length;
---

<AdminLayout title={isRtl ? 'مكتبة الوسائط والصور' : 'Media Assets Library'} requiredPermission="media:read">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-['Amiri',serif] text-[#FAF7F2] mb-1">
        {isRtl ? 'مكتبة الوسائط والصور الآمنة' : 'Secure Media Library'}
      </h1>
      <p class="text-xs sm:text-sm text-[#D8C4A3]/70 font-light">
        {isRtl
          ? 'إدارة الأصول الرقمية، رفع الصور المحسّنة (WebP)، تجريد بيانات EXIF، وحماية الروابط المرجعية'
          : 'Upload, manage, and optimize WebP imagery with automatic EXIF stripping and referential safety'}
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="open-upload-modal-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] transition-all shadow-md shadow-[#A87952]/20 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span>{isRtl ? 'رفع صورة جديدة' : 'Upload Image'}</span>
      </button>
    </div>
  </div>

  <!-- Metric Badges -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="p-4 rounded-xl bg-[#1C130D]/70 border border-[#A87952]/20">
      <span class="text-[11px] text-[#D8C4A3]/60 block mb-1">{isRtl ? 'إجمالي الملفات' : 'Total Files'}</span>
      <span class="text-xl font-bold font-mono text-[#FAF7F2]" id="stat-total-count">{totalCount}</span>
    </div>
    <div class="p-4 rounded-xl bg-[#1C130D]/70 border border-[#A87952]/20">
      <span class="text-[11px] text-[#D8C4A3]/60 block mb-1">{isRtl ? 'الحجم الإجمالي' : 'Total Storage'}</span>
      <span class="text-xl font-bold font-mono text-[#C5A880]">{formatFileSize(totalSize)}</span>
    </div>
    <div class="p-4 rounded-xl bg-[#1C130D]/70 border border-[#A87952]/20">
      <span class="text-[11px] text-[#D8C4A3]/60 block mb-1">{isRtl ? 'مرتبطة بمحتوى' : 'In-Use Assets'}</span>
      <span class="text-xl font-bold font-mono text-emerald-400">{usedCount}</span>
    </div>
    <div class="p-4 rounded-xl bg-[#1C130D]/70 border border-[#A87952]/20">
      <span class="text-[11px] text-[#D8C4A3]/60 block mb-1">{isRtl ? 'غير مستخدمة' : 'Unused Assets'}</span>
      <span class="text-xl font-bold font-mono text-amber-400">{totalCount - usedCount}</span>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="p-4 rounded-2xl bg-[#1C130D]/60 border border-[#A87952]/20 mb-6 flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
    <!-- Search Bar -->
    <div class="relative flex-1">
      <input
        type="text"
        id="media-search-input"
        placeholder={isRtl ? 'بحث باسم الملف، العنوان، أو النص البديل...' : 'Search by filename, title, or alt text...'}
        class="w-full ps-10 pe-4 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] placeholder-[#D8C4A3]/40 focus:border-[#C5A880] focus:outline-none transition-colors"
      />
      <svg class="w-4 h-4 absolute top-2.5 start-3 text-[#D8C4A3]/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <!-- Filters -->
    <div class="flex items-center gap-2">
      <!-- Type Filter -->
      <select
        id="media-type-filter"
        class="px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none cursor-pointer"
      >
        <option value="all">{isRtl ? 'كافة الصيغ' : 'All Formats'}</option>
        <option value="webp">WebP</option>
        <option value="jpeg">JPEG / JPG</option>
        <option value="png">PNG</option>
      </select>

      <!-- Usage Filter -->
      <select
        id="media-usage-filter"
        class="px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none cursor-pointer"
      >
        <option value="all">{isRtl ? 'كافة الحالات' : 'All Status'}</option>
        <option value="used">{isRtl ? 'مرتبطة بمحتوى' : 'In Use'}</option>
        <option value="unused">{isRtl ? 'غير مستخدمة' : 'Unused'}</option>
      </select>

      <!-- Sort -->
      <select
        id="media-sort-filter"
        class="px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none cursor-pointer"
      >
        <option value="desc">{isRtl ? 'الأحدث أولاً' : 'Newest'}</option>
        <option value="asc">{isRtl ? 'الأقدم أولاً' : 'Oldest'}</option>
      </select>
    </div>
  </div>

  <!-- Toast Notification Alert -->
  <div id="media-toast" class="hidden fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span id="media-toast-icon"></span>
      <span id="media-toast-msg" class="text-xs font-medium"></span>
    </div>
    <button type="button" onclick="document.getElementById('media-toast').classList.add('hidden')" class="text-xs opacity-70 hover:opacity-100">✕</button>
  </div>

  <!-- Media Grid -->
  <div
    id="media-grid"
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4"
  >
    {mediaFiles.map((file) => {
      const isUsed = Number(file.usage_count) > 0;
      const typeShort = String(file.mime_type || '').replace('image/', '').toUpperCase();
      return (
        <div
          class="media-card rounded-2xl bg-[#1C130D]/80 border border-[#A87952]/25 overflow-hidden hover:border-[#C5A880]/60 transition-all duration-300 shadow-lg group flex flex-col relative"
          data-id={file.id}
          data-filename={file.filename}
          data-original-name={file.original_name}
          data-mime={file.mime_type}
          data-size={file.file_size}
          data-width={file.width}
          data-height={file.height}
          data-public-url={file.public_url}
          data-alt-ar={file.alt_ar || ''}
          data-alt-en={file.alt_en || ''}
          data-title-ar={file.title_ar || ''}
          data-title-en={file.title_en || ''}
          data-usage={file.usage_count}
          data-created={file.created_at}
          data-uploader={file.uploader_name || ''}
        >
          <!-- Thumbnail -->
          <div class="relative aspect-square bg-[#140D09] overflow-hidden flex items-center justify-center cursor-pointer view-details-trigger">
            {file.public_url ? (
              <img
                src={file.public_url as string}
                alt={(file.alt_ar || file.original_name) as string}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="text-[#D8C4A3]/30">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            )}

            <!-- Format & Size Badges -->
            <div class="absolute top-2 inset-x-2 flex items-center justify-between pointer-events-none">
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-black/70 backdrop-blur-sm text-[#FAF7F2] border border-white/10">
                {typeShort}
              </span>
              {isUsed ? (
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 backdrop-blur-sm">
                  {isRtl ? 'مرتبطة' : 'In Use'}
                </span>
              ) : (
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-amber-950/70 border border-amber-500/30 text-amber-300 backdrop-blur-sm">
                  {isRtl ? 'غير مستخدمة' : 'Unused'}
                </span>
              )}
            </div>

            <!-- Hover Quick Action Overlay -->
            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 p-2 pointer-events-auto">
              <button
                type="button"
                class="view-preview-btn p-2 rounded-xl bg-[#241814]/90 hover:bg-[#C5A880] text-[#FAF7F2] hover:text-[#140D09] transition-colors cursor-pointer"
                title={isRtl ? 'معاينة وتفاصيل' : 'Preview & Details'}
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
              <button
                type="button"
                class="copy-url-btn p-2 rounded-xl bg-[#241814]/90 hover:bg-[#C5A880] text-[#FAF7F2] hover:text-[#140D09] transition-colors cursor-pointer"
                title={isRtl ? 'نسخ رابط الصورة' : 'Copy URL'}
                data-url={file.public_url}
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
              <button
                type="button"
                class="delete-media-btn p-2 rounded-xl bg-red-950/80 hover:bg-red-600 text-red-300 hover:text-white transition-colors cursor-pointer"
                title={isRtl ? 'حذف الصورة' : 'Delete Image'}
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Card Metadata -->
          <div class="p-2.5 flex-1 flex flex-col justify-between">
            <div class="font-medium text-[11px] text-[#FAF7F2] truncate mb-0.5" title={file.original_name as string}>
              {file.original_name}
            </div>
            <div class="flex items-center justify-between text-[10px] text-[#D8C4A3]/50 font-mono">
              <span>{file.width ? `${file.width}×${file.height}` : '—'}</span>
              <span>{formatFileSize(Number(file.file_size))}</span>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty Search Results State -->
  <div id="media-no-results" class="hidden text-center py-16 px-4 bg-[#1C130D]/40 rounded-2xl border border-[#A87952]/20">
    <svg class="w-12 h-12 text-[#D8C4A3]/30 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <p class="text-sm text-[#FAF7F2] font-semibold mb-1">
      {isRtl ? 'لم يتم العثور على أي ملفات مطابقة' : 'No matching files found'}
    </p>
    <p class="text-xs text-[#D8C4A3]/60">
      {isRtl ? 'جرّب البحث بكلمات أخرى أو تغيير الفلاتر المحددة' : 'Try searching with different terms or changing your filters'}
    </p>
  </div>

  <!-- UPLOAD MODAL -->
  <div id="upload-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1C130D] border border-[#A87952]/30 rounded-2xl w-full max-w-lg p-6 shadow-2xl overflow-y-auto max-h-[90vh]">
      <div class="flex items-center justify-between pb-4 border-b border-[#A87952]/20 mb-4">
        <div>
          <h3 class="text-lg font-bold font-['Amiri',serif] text-[#FAF7F2]">
            {isRtl ? 'رفع صورة جديدة ومعالجتها' : 'Upload & Optimize Image'}
          </h3>
          <p class="text-xs text-[#D8C4A3]/60">
            {isRtl ? 'الأنواع المدعومة: JPG, PNG, WebP (الحد الأقصى: 10 ميجابايت)' : 'Supported: JPG, PNG, WebP (Max: 10MB)'}
          </p>
        </div>
        <button type="button" id="close-upload-modal-btn" class="text-[#D8C4A3]/60 hover:text-[#FAF7F2] text-xl cursor-pointer">✕</button>
      </div>

      <form id="upload-form" class="space-y-4">
        <!-- File Dropzone -->
        <div
          id="dropzone"
          class="border-2 border-dashed border-[#A87952]/40 rounded-xl p-6 text-center hover:border-[#C5A880] transition-colors cursor-pointer bg-[#140D09]/50 flex flex-col items-center justify-center min-h-[160px]"
        >
          <input
            type="file"
            id="file-input"
            name="file"
            accept="image/jpeg,image/png,image/webp"
            required
            class="hidden"
          />

          <!-- Preview Before Upload -->
          <div id="dropzone-preview-container" class="hidden mb-3">
            <img id="dropzone-preview-img" class="w-32 h-32 object-cover rounded-xl border border-[#A87952]/40 mx-auto" />
            <span id="dropzone-preview-name" class="block text-xs text-[#FAF7F2] font-mono mt-1"></span>
          </div>

          <!-- Prompt -->
          <div id="dropzone-prompt">
            <svg class="w-10 h-10 text-[#C5A880]/60 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-xs text-[#FAF7F2] font-medium mb-1">
              {isRtl ? 'اسحب الصورة وأفلتها هنا، أو اضغط للاختيار' : 'Drag & drop image here, or click to browse'}
            </p>
            <p class="text-[11px] text-[#D8C4A3]/50">
              {isRtl ? 'سيتم التحقق من محتوى الملف وتجريد بيانات EXIF وتحويله إلى WebP' : 'Files are stripped of EXIF data & converted to WebP'}
            </p>
          </div>
        </div>

        <!-- Optional Alt Text -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">
              {isRtl ? 'النص البديل (عربي) Alt Text' : 'Alt Text (Arabic)'}
            </label>
            <input
              type="text"
              id="upload-alt-ar"
              name="alt_ar"
              placeholder={isRtl ? 'وصف مختصر للصورة' : 'Brief image description'}
              class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">
              {isRtl ? 'النص البديل (إنجليزي) Alt Text' : 'Alt Text (English)'}
            </label>
            <input
              type="text"
              id="upload-alt-en"
              name="alt_en"
              placeholder={isRtl ? 'Brief image description' : 'Brief image description'}
              class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
            />
          </div>
        </div>

        <!-- Optional Title -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">
              {isRtl ? 'عنوان الصورة (عربي)' : 'Title (Arabic)'}
            </label>
            <input
              type="text"
              id="upload-title-ar"
              name="title_ar"
              placeholder={isRtl ? 'عنوان اختياري' : 'Optional title'}
              class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">
              {isRtl ? 'عنوان الصورة (إنجليزي)' : 'Title (English)'}
            </label>
            <input
              type="text"
              id="upload-title-en"
              name="title_en"
              placeholder={isRtl ? 'Optional title' : 'Optional title'}
              class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
            />
          </div>
        </div>

        <!-- Submit & Cancel -->
        <div class="pt-4 border-t border-[#A87952]/20 flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-upload-btn"
            class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer"
          >
            {isRtl ? 'إلغاء' : 'Cancel'}
          </button>
          <button
            type="submit"
            id="submit-upload-btn"
            class="px-5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] cursor-pointer shadow-md flex items-center gap-2"
          >
            <span id="upload-spinner" class="hidden animate-spin">⏳</span>
            <span id="upload-btn-text">{isRtl ? 'رفع ومعالجة' : 'Upload & Process'}</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- PREVIEW & EDIT MODAL -->
  <div id="preview-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1C130D] border border-[#A87952]/30 rounded-2xl w-full max-w-3xl p-6 shadow-2xl overflow-y-auto max-h-[92vh]">
      <div class="flex items-center justify-between pb-4 border-b border-[#A87952]/20 mb-4">
        <div>
          <h3 class="text-lg font-bold font-['Amiri',serif] text-[#FAF7F2]">
            {isRtl ? 'تفاصيل ومعاينة ملف الصورة' : 'Image Details & Metadata'}
          </h3>
          <p id="preview-modal-sub" class="text-xs text-[#D8C4A3]/60 font-mono"></p>
        </div>
        <button type="button" id="close-preview-modal-btn" class="text-[#D8C4A3]/60 hover:text-[#FAF7F2] text-xl cursor-pointer">✕</button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Image Preview Frame -->
        <div class="flex flex-col items-center justify-center bg-[#140D09] rounded-xl border border-[#A87952]/20 p-3 overflow-hidden">
          <img
            id="preview-img-tag"
            src=""
            alt=""
            class="max-w-full max-h-72 object-contain rounded-lg shadow-md mb-3"
          />
          <div class="w-full flex items-center justify-between gap-2 pt-2 border-t border-[#A87952]/15 text-[11px] font-mono text-[#D8C4A3]/70">
            <span id="preview-dimensions-txt"></span>
            <span id="preview-size-txt"></span>
            <span id="preview-mime-txt" class="px-1.5 py-0.5 rounded bg-black/60 text-[#FAF7F2]"></span>
          </div>
        </div>

        <!-- Details & Edit Form -->
        <div class="flex flex-col justify-between space-y-4">
          <!-- Copy URL Box -->
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'رابط الصورة المباشر' : 'Public Image URL'}</label>
            <div class="flex items-center gap-2">
              <input
                type="text"
                id="preview-url-input"
                readonly
                class="w-full px-3 py-1.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] font-mono select-all focus:outline-none"
              />
              <button
                type="button"
                id="preview-copy-btn"
                class="px-3 py-1.5 rounded-xl bg-[#241814] hover:bg-[#C5A880] text-[#FAF7F2] hover:text-[#140D09] text-xs font-semibold transition-colors shrink-0 cursor-pointer border border-[#A87952]/30"
              >
                {isRtl ? 'نسخ' : 'Copy'}
              </button>
            </div>
          </div>

          <!-- Usage Status Box -->
          <div id="preview-usage-box" class="p-3 rounded-xl bg-[#140D09] border border-[#A87952]/20 text-xs">
            <span class="block text-[11px] text-[#D8C4A3]/60 mb-1">{isRtl ? 'حالة الارتباط بالموقع:' : 'Site Content Usage:'}</span>
            <div id="preview-usage-content" class="text-xs"></div>
          </div>

          <!-- Edit Metadata Form -->
          <form id="edit-metadata-form" class="space-y-3">
            <input type="hidden" id="edit-media-id" />

            <div>
              <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'النص البديل (عربي) Alt Text' : 'Alt Text (Arabic)'}</label>
              <input
                type="text"
                id="edit-alt-ar"
                class="w-full px-3 py-1.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'النص البديل (إنجليزي) Alt Text' : 'Alt Text (English)'}</label>
              <input
                type="text"
                id="edit-alt-en"
                class="w-full px-3 py-1.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
              />
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'العنوان (عربي)' : 'Title (Arabic)'}</label>
                <input
                  type="text"
                  id="edit-title-ar"
                  class="w-full px-3 py-1.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
                />
              </div>
              <div>
                <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'العنوان (إنجليزي)' : 'Title (English)'}</label>
                <input
                  type="text"
                  id="edit-title-en"
                  class="w-full px-3 py-1.5 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"
                />
              </div>
            </div>

            <div class="pt-2 flex items-center justify-between gap-3">
              <button
                type="button"
                id="preview-delete-btn"
                class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-red-950/60 border border-red-500/40 text-red-300 hover:bg-red-600 hover:text-white transition-colors cursor-pointer"
              >
                {isRtl ? 'حذف الصورة' : 'Delete'}
              </button>

              <button
                type="submit"
                id="save-metadata-btn"
                class="px-4 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] cursor-pointer shadow-md"
              >
                {isRtl ? 'تحديث البيانات' : 'Save Changes'}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="delete-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1C130D] border border-red-500/30 rounded-2xl w-full max-w-md p-6 shadow-2xl text-center">
      <div class="w-12 h-12 rounded-full bg-red-950/50 border border-red-500/40 text-red-400 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>

      <h3 class="text-base font-bold text-[#FAF7F2] mb-2 font-['Amiri',serif]">
        {isRtl ? 'تأكيد حذف الصورة' : 'Confirm Media Deletion'}
      </h3>

      <div id="delete-warning-text" class="text-xs text-[#D8C4A3]/80 mb-6 leading-relaxed">
        {isRtl ? 'هل أنت متأكد من رغبتك في حذف هذه الصورة من النظام؟' : 'Are you sure you want to permanently delete this media asset?'}
      </div>

      <div class="flex items-center justify-center gap-3">
        <button
          type="button"
          id="cancel-delete-btn"
          class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer"
        >
          {isRtl ? 'إلغاء' : 'Cancel'}
        </button>
        <button
          type="button"
          id="confirm-delete-btn"
          class="px-5 py-2 rounded-xl text-xs font-semibold bg-red-600 hover:bg-red-700 text-white cursor-pointer shadow-md"
        >
          {isRtl ? 'نعم، حذف نهائي' : 'Yes, Delete'}
        </button>
      </div>
    </div>
  </div>

  <!-- Client-side Interactive Logic -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('media-search-input');
      const typeFilter = document.getElementById('media-type-filter');
      const usageFilter = document.getElementById('media-usage-filter');
      const sortFilter = document.getElementById('media-sort-filter');
      const grid = document.getElementById('media-grid');
      const noResults = document.getElementById('media-no-results');

      // Modals
      const uploadModal = document.getElementById('upload-modal');
      const previewModal = document.getElementById('preview-modal');
      const deleteModal = document.getElementById('delete-modal');

      // Upload controls
      const openUploadBtn = document.getElementById('open-upload-modal-btn');
      const closeUploadBtn = document.getElementById('close-upload-modal-btn');
      const cancelUploadBtn = document.getElementById('cancel-upload-btn');
      const uploadForm = document.getElementById('upload-form');
      const fileInput = document.getElementById('file-input');
      const dropzone = document.getElementById('dropzone');
      const dropzonePrompt = document.getElementById('dropzone-prompt');
      const dropzonePreviewContainer = document.getElementById('dropzone-preview-container');
      const dropzonePreviewImg = document.getElementById('dropzone-preview-img');
      const dropzonePreviewName = document.getElementById('dropzone-preview-name');
      const uploadSpinner = document.getElementById('upload-spinner');
      const uploadBtnText = document.getElementById('upload-btn-text');

      // Preview & Edit controls
      const closePreviewBtn = document.getElementById('close-preview-modal-btn');
      const previewImgTag = document.getElementById('preview-img-tag');
      const previewModalSub = document.getElementById('preview-modal-sub');
      const previewDimensionsTxt = document.getElementById('preview-dimensions-txt');
      const previewSizeTxt = document.getElementById('preview-size-txt');
      const previewMimeTxt = document.getElementById('preview-mime-txt');
      const previewUrlInput = document.getElementById('preview-url-input');
      const previewCopyBtn = document.getElementById('preview-copy-btn');
      const previewUsageContent = document.getElementById('preview-usage-content');
      const editMetadataForm = document.getElementById('edit-metadata-form');
      const editMediaId = document.getElementById('edit-media-id');
      const editAltAr = document.getElementById('edit-alt-ar');
      const editAltEn = document.getElementById('edit-alt-en');
      const editTitleAr = document.getElementById('edit-title-ar');
      const editTitleEn = document.getElementById('edit-title-en');
      const previewDeleteBtn = document.getElementById('preview-delete-btn');

      // Delete confirmation controls
      const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
      const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
      const deleteWarningText = document.getElementById('delete-warning-text');
      let targetDeleteId = null;

      // Toast
      const toast = document.getElementById('media-toast');
      const toastMsg = document.getElementById('media-toast-msg');
      const toastIcon = document.getElementById('media-toast-icon');

      function showToast(message, isSuccess = true) {
        toast.className = `fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between ${
          isSuccess
            ? 'bg-[#142617] border-emerald-500/50 text-emerald-200'
            : 'bg-[#2b1111] border-red-500/50 text-red-200'
        }`;
        toastIcon.innerHTML = isSuccess ? '✓' : '⚠️';
        toastMsg.textContent = message;
        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 4000);
      }

      function formatBytes(bytes) {
        if (!bytes) return '0 B';
        const b = Number(bytes);
        if (b < 1024) return b + ' B';
        if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
        return (b / (1024 * 1024)).toFixed(2) + ' MB';
      }

      // Filter and Search
      function applyFilters() {
        const query = (searchInput.value || '').trim().toLowerCase();
        const type = (typeFilter.value || 'all').toLowerCase();
        const usage = (usageFilter.value || 'all').toLowerCase();
        const sort = sortFilter.value || 'desc';

        const cards = Array.from(grid.querySelectorAll('.media-card'));
        let visibleCount = 0;

        cards.forEach((card) => {
          const fn = (card.dataset.filename || '').toLowerCase();
          const orig = (card.dataset.originalName || '').toLowerCase();
          const altAr = (card.dataset.altAr || '').toLowerCase();
          const altEn = (card.dataset.altEn || '').toLowerCase();
          const titleAr = (card.dataset.titleAr || '').toLowerCase();
          const titleEn = (card.dataset.titleEn || '').toLowerCase();
          const mime = (card.dataset.mime || '').toLowerCase();
          const usageCount = Number(card.dataset.usage || 0);

          // 1. Query search
          const matchQuery =
            !query ||
            fn.includes(query) ||
            orig.includes(query) ||
            altAr.includes(query) ||
            altEn.includes(query) ||
            titleAr.includes(query) ||
            titleEn.includes(query);

          // 2. Type filter
          let matchType = true;
          if (type === 'webp') matchType = mime.includes('webp');
          else if (type === 'jpeg') matchType = mime.includes('jpeg') || mime.includes('jpg');
          else if (type === 'png') matchType = mime.includes('png');

          // 3. Usage filter
          let matchUsage = true;
          if (usage === 'used') matchUsage = usageCount > 0;
          else if (usage === 'unused') matchUsage = usageCount === 0;

          if (matchQuery && matchType && matchUsage) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Sort DOM elements
        cards.sort((a, b) => {
          const tA = Number(a.dataset.created || 0);
          const tB = Number(b.dataset.created || 0);
          return sort === 'asc' ? tA - tB : tB - tA;
        });
        cards.forEach((card) => grid.appendChild(card));

        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      searchInput.addEventListener('input', applyFilters);
      typeFilter.addEventListener('change', applyFilters);
      usageFilter.addEventListener('change', applyFilters);
      sortFilter.addEventListener('change', applyFilters);

      // Open / Close Upload Modal
      openUploadBtn?.addEventListener('click', () => {
        uploadForm.reset();
        dropzonePreviewContainer.classList.add('hidden');
        dropzonePrompt.classList.remove('hidden');
        uploadModal.classList.remove('hidden');
      });

      closeUploadBtn?.addEventListener('click', () => uploadModal.classList.add('hidden'));
      cancelUploadBtn?.addEventListener('click', () => uploadModal.classList.add('hidden'));

      // Dropzone Click & Drag/Drop
      dropzone?.addEventListener('click', () => fileInput.click());

      dropzone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('border-[#C5A880]', 'bg-[#1C130D]');
      });

      dropzone?.addEventListener('dragleave', () => {
        dropzone.classList.remove('border-[#C5A880]', 'bg-[#1C130D]');
      });

      dropzone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-[#C5A880]', 'bg-[#1C130D]');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          fileInput.files = e.dataTransfer.files;
          handleFileSelect(e.dataTransfer.files[0]);
        }
      });

      fileInput?.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          handleFileSelect(e.target.files[0]);
        }
      });

      function handleFileSelect(file) {
        if (!file.type.match(/image\/(jpeg|png|webp)/)) {
          showToast('يرجى اختيار ملف صورة صالح (JPG, PNG, WebP فقط)', false);
          fileInput.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          showToast('حجم الملف يتجاوز الحد الأقصى 10 ميجابايت', false);
          fileInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
          dropzonePreviewImg.src = e.target.result;
          dropzonePreviewName.textContent = file.name;
          dropzonePreviewContainer.classList.remove('hidden');
          dropzonePrompt.classList.add('hidden');
        };
        reader.readAsDataURL(file);
      }

      // Handle Upload Submit
      uploadForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const file = fileInput.files[0];
        if (!file) {
          showToast('يرجى اختيار صورة أولاً', false);
          return;
        }

        uploadSpinner.classList.remove('hidden');
        uploadBtnText.textContent = 'جاري المعالجة...';

        const formData = new FormData(uploadForm);

        try {
          const res = await fetch('/api/admin/media/upload', {
            method: 'POST',
            body: formData,
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'فشل في رفع الصورة');
          }

          showToast('تم رفع الصورة ومعالجتها بنجاح!');
          uploadModal.classList.add('hidden');
          // Reload page to display new image with all server statistics
          setTimeout(() => window.location.reload(), 600);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          uploadSpinner.classList.add('hidden');
          uploadBtnText.textContent = 'رفع ومعالجة';
        }
      });

      // Preview / Edit modal handler
      async function openPreviewModal(card) {
        const id = card.dataset.id;
        const publicUrl = card.dataset.publicUrl;
        const origName = card.dataset.originalName;
        const fn = card.dataset.filename;
        const mime = card.dataset.mime;
        const width = card.dataset.width;
        const height = card.dataset.height;
        const size = card.dataset.size;
        const altAr = card.dataset.altAr || '';
        const altEn = card.dataset.altEn || '';
        const titleAr = card.dataset.titleAr || '';
        const titleEn = card.dataset.titleEn || '';

        editMediaId.value = id;
        previewImgTag.src = publicUrl;
        previewImgTag.alt = origName;
        previewModalSub.textContent = `${origName} (${fn})`;
        previewDimensionsTxt.textContent = width ? `${width} × ${height} px` : '—';
        previewSizeTxt.textContent = formatBytes(size);
        previewMimeTxt.textContent = (mime || '').toUpperCase();
        previewUrlInput.value = window.location.origin + publicUrl;

        editAltAr.value = altAr;
        editAltEn.value = altEn;
        editTitleAr.value = titleAr;
        editTitleEn.value = titleEn;

        // Fetch deep dependency usage
        previewUsageContent.innerHTML = '<span class="text-[#D8C4A3]/50">جاري فحص الارتباطات...</span>';
        previewModal.classList.remove('hidden');

        try {
          const res = await fetch(`/api/admin/media/${id}`);
          const resData = await res.json();
          if (res.ok && resData.success && resData.data.usage) {
            const usage = resData.data.usage;
            if (usage.isInUse) {
              const items = usage.references
                .map((r) => `<li class="text-emerald-300 font-medium">${r.type}: ${r.nameAr} (${r.nameEn})</li>`)
                .join('');
              previewUsageContent.innerHTML = `
                <div class="text-amber-300 mb-1 font-semibold">⚠️ مستخدمة في الأقسام التالية:</div>
                <ul class="list-disc list-inside space-y-0.5 text-[11px]">${items}</ul>
              `;
            } else {
              previewUsageContent.innerHTML = '<span class="text-amber-400">هذه الصورة غير مرتبطة بأي محتوى حالياً (يمكن حذفها بأمان).</span>';
            }
          }
        } catch {
          previewUsageContent.innerHTML = '<span class="text-red-400">تعذر جلب تفاصيل الاستخدام.</span>';
        }
      }

      closePreviewBtn?.addEventListener('click', () => previewModal.classList.add('hidden'));

      // Copy URL Button in preview
      previewCopyBtn?.addEventListener('click', () => {
        previewUrlInput.select();
        navigator.clipboard.writeText(previewUrlInput.value);
        showToast('تم نسخ رابط الصورة إلى الحافظة!');
      });

      // Save Metadata (Alt text / title)
      editMetadataForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = editMediaId.value;
        const payload = {
          alt_ar: editAltAr.value.trim(),
          alt_en: editAltEn.value.trim(),
          title_ar: editTitleAr.value.trim() || null,
          title_en: editTitleEn.value.trim() || null,
        };

        try {
          const res = await fetch(`/api/admin/media/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'فشل في حفظ التعديلات');
          }

          // Update card attributes in DOM
          const card = grid.querySelector(`.media-card[data-id="${id}"]`);
          if (card) {
            card.dataset.altAr = payload.alt_ar;
            card.dataset.altEn = payload.alt_en;
            card.dataset.titleAr = payload.title_ar || '';
            card.dataset.titleEn = payload.title_en || '';
          }

          showToast('تم تحديث النص البديل والبيانات بنجاح!');
          previewModal.classList.add('hidden');
        } catch (err) {
          showToast(err.message, false);
        }
      });

      // Delete Trigger from Preview
      previewDeleteBtn?.addEventListener('click', () => {
        const id = editMediaId.value;
        previewModal.classList.add('hidden');
        initiateDelete(id);
      });

      // Delete confirmation modal logic
      function initiateDelete(id) {
        targetDeleteId = id;
        const card = grid.querySelector(`.media-card[data-id="${id}"]`);
        const name = card ? card.dataset.originalName : id;
        deleteWarningText.innerHTML = `هل أنت متأكد من رغبتك في حذف ملف الصورة <strong class="text-[#FAF7F2]">(${name})</strong>؟<br><span class="text-[11px] text-amber-300">ملاحظة: سيتم رفض الحذف تلقائياً إذا كانت الصورة مستخدمة في أي خدمة أو عرض أو مقال أو عنصر بالمعرض.</span>`;
        deleteModal.classList.remove('hidden');
      }

      cancelDeleteBtn?.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
        targetDeleteId = null;
      });

      confirmDeleteBtn?.addEventListener('click', async () => {
        if (!targetDeleteId) return;

        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.textContent = 'جاري التحقق والحذف...';

        try {
          const res = await fetch(`/api/admin/media/${targetDeleteId}`, {
            method: 'DELETE',
          });
          const data = await res.json();

          if (!res.ok || !data.success) {
            throw new Error(data.error || 'تعذر حذف الصورة');
          }

          showToast('تم حذف ملف الصورة بنجاح.');
          deleteModal.classList.add('hidden');

          // Remove card from DOM
          const card = grid.querySelector(`.media-card[data-id="${targetDeleteId}"]`);
          if (card) card.remove();

          // Update total count
          const statBadge = document.getElementById('stat-total-count');
          if (statBadge) {
            statBadge.textContent = String(Math.max(0, Number(statBadge.textContent) - 1));
          }
        } catch (err) {
          showToast(err.message, false);
          deleteModal.classList.add('hidden');
        } finally {
          confirmDeleteBtn.disabled = false;
          confirmDeleteBtn.textContent = 'نعم، حذف نهائي';
          targetDeleteId = null;
        }
      });

      // Bind events to each card
      grid.querySelectorAll('.media-card').forEach((card) => {
        // Thumbnail click / View Preview trigger
        card.querySelector('.view-details-trigger')?.addEventListener('click', (e) => {
          if (e.target.closest('button')) return; // ignore if button clicked
          openPreviewModal(card);
        });

        card.querySelector('.view-preview-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          openPreviewModal(card);
        });

        // Copy URL button
        card.querySelector('.copy-url-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = card.dataset.publicUrl;
          const fullUrl = window.location.origin + url;
          navigator.clipboard.writeText(fullUrl);
          showToast('تم نسخ رابط الصورة إلى الحافظة!');
        });

        // Delete button
        card.querySelector('.delete-media-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          initiateDelete(card.dataset.id);
        });
      });
    });
  </script>
</AdminLayout>
