      <h3 class="text-base font-bold text-[#FAF7F2] mb-2 font-['Amiri',serif]">
        {isRtl ? 'تأكيد حذف المراجعة' : 'Confirm Deletion'}
      </h3>
      <p class="text-xs text-[#D8C4A3]/80 mb-6 leading-relaxed">
        {isRtl ? 'هل أنتِ متأكدة من حذف مراجعة' : 'Are you sure you want to delete review by'}
        <strong id="delete-review-name" class="text-[#FAF7F2]"></strong>؟
      </p>
      <div class="flex items-center justify-center gap-3">
        <button type="button" id="cancel-review-delete-btn" class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer">
          {isRtl ? 'إلغاء' : 'Cancel'}
        </button>
        <button type="button" id="confirm-review-delete-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-red-600 hover:bg-red-700 text-white cursor-pointer shadow-md">
          {isRtl ? 'نعم، حذف' : 'Yes, Delete'}
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('review-modal');
      const detailModal = document.getElementById('review-detail-modal');
      const replaceModal = document.getElementById('replace-demo-modal');
      const deleteModal = document.getElementById('review-delete-modal');
      const form = document.getElementById('review-form');
      const replaceForm = document.getElementById('replace-demo-form');
      const toast = document.getElementById('review-toast');
      const toastMsg = document.getElementById('review-toast-msg');
      const toastIcon = document.getElementById('review-toast-icon');

      function showToast(message, isSuccess = true) {
        toast.className = `fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between ${
          isSuccess ? 'bg-[#142617] border-emerald-500/50 text-emerald-200' : 'bg-[#2b1111] border-red-500/50 text-red-200'
        }`;
        toastIcon.textContent = isSuccess ? '✓' : '✗';
        toastMsg.textContent = message;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 4000);
      }

      // View Switcher (Cards vs Table)
      const btnViewGuestbook = document.getElementById('tab-view-guestbook');
      const btnViewTable = document.getElementById('tab-view-table');
      const sectionCards = document.getElementById('guestbook-cards-section');
      const sectionTable = document.getElementById('reviews-table-section');

      btnViewGuestbook?.addEventListener('click', () => {
        btnViewGuestbook.classList.add('bg-[#38251F]', 'text-[#FAF7F2]', 'border', 'border-[#C5A880]/40', 'shadow-sm');
        btnViewGuestbook.classList.remove('text-[#D8C4A3]/70');
        btnViewTable.classList.remove('bg-[#38251F]', 'text-[#FAF7F2]', 'border', 'border-[#C5A880]/40', 'shadow-sm');
        btnViewTable.classList.add('text-[#D8C4A3]/70');

        sectionCards.classList.remove('hidden');
        sectionTable.classList.add('hidden');
      });

      btnViewTable?.addEventListener('click', () => {
        btnViewTable.classList.add('bg-[#38251F]', 'text-[#FAF7F2]', 'border', 'border-[#C5A880]/40', 'shadow-sm');
        btnViewTable.classList.remove('text-[#D8C4A3]/70');
        btnViewGuestbook.classList.remove('bg-[#38251F]', 'text-[#FAF7F2]', 'border', 'border-[#C5A880]/40', 'shadow-sm');
        btnViewGuestbook.classList.add('text-[#D8C4A3]/70');

        sectionCards.classList.add('hidden');
        sectionTable.classList.remove('hidden');
      });

      // Filter Tabs Handler (for table view)
      const tabBtns = document.querySelectorAll('.review-tab-btn');
      const rows = document.querySelectorAll('.review-row');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => {
            b.classList.remove('bg-[#38251F]', 'text-[#FAF7F2]', 'border-[#C5A880]/40');
            b.classList.add('text-[#D8C4A3]/70', 'border-transparent');
          });
          btn.classList.add('bg-[#38251F]', 'text-[#FAF7F2]', 'border-[#C5A880]/40');
          btn.classList.remove('text-[#D8C4A3]/70', 'border-transparent');

          const filter = btn.getAttribute('data-filter');
          rows.forEach((row) => {
            const status = row.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        });
      });

      // Quick Accept Button
      document.querySelectorAll('.action-accept-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const rev = JSON.parse(btn.getAttribute('data-json') || '{}');
          await updateReviewStatus(rev, 1, 'تم اعتماد التقييم ونشره بنجاح');
        });
      });

      // Quick Reject Button
      document.querySelectorAll('.action-reject-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const rev = JSON.parse(btn.getAttribute('data-json') || '{}');
          await updateReviewStatus(rev, -1, 'تم رفض التقييم واستبعاده من النشر');
        });
      });

      async function updateReviewStatus(rev, newStatus, successMsg) {
        try {
          const res = await fetch(`/api/admin/reviews/${encodeURIComponent(rev.id)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
            body: JSON.stringify({
              ...rev,
              is_approved: newStatus,
            }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشلت العملية');
          showToast(successMsg, true);
          setTimeout(() => window.location.reload(), 600);
        } catch (err) {
          showToast(err.message, false);
        }
      }

      // Replace Demo Model with Real Review
      document.querySelectorAll('.replace-demo-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const demoId = btn.getAttribute('data-id');
          const demoName = btn.getAttribute('data-name');
          const demoTopic = btn.getAttribute('data-topic');

          document.getElementById('replace-demo-id').value = demoId;
          document.getElementById('replace-demo-subtitle').textContent = `النموذج المراد استبداله: (${demoName} — ${demoTopic})`;
          document.getElementById('replace-client-name').value = '';
          document.getElementById('replace-quote-ar').value = '';

          replaceModal.classList.remove('hidden');
        });
      });

      document.getElementById('close-replace-modal-btn')?.addEventListener('click', () => replaceModal.classList.add('hidden'));
      document.getElementById('cancel-replace-btn')?.addEventListener('click', () => replaceModal.classList.add('hidden'));

      replaceForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const demoId = document.getElementById('replace-demo-id').value;
        const realName = document.getElementById('replace-client-name').value.trim();
        const serviceId = document.getElementById('replace-service-id').value || null;
        const rating = Number(document.getElementById('replace-rating').value) || 5;
        const quoteAr = document.getElementById('replace-quote-ar').value.trim();
        const isApproved = document.getElementById('replace-is-approved').checked ? 1 : 0;

        const confirmBtn = document.getElementById('confirm-replace-btn');
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'جاري الحفظ...';

        try {
          const res = await fetch('/api/admin/reviews/replace-demo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
            body: JSON.stringify({
              demo_id: demoId,
              author_name: realName,
              service_id: serviceId,
              rating,
              quote_ar: quoteAr,
              quote_en: quoteAr,
              is_approved: isApproved,
            }),
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشلت العملية');

          showToast('تم استبدال النموذج بنجاح بالتقييم الحقيقي!', true);
          replaceModal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 700);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = '✓ حفظ واستبدال التقييم';
        }
      });

      // View Demo Card Full Modal
      document.querySelectorAll('.view-demo-modal-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const name = btn.getAttribute('data-name');
          const topic = btn.getAttribute('data-topic');
          const quoteAr = btn.getAttribute('data-quote-ar');
          const quoteEn = btn.getAttribute('data-quote-en');

          document.getElementById('detail-author').textContent = name;
          document.getElementById('detail-title').textContent = `(نموذج تجريبي — ${topic})`;
          document.getElementById('detail-rating').textContent = '★★★★★ (5/5)';
          document.getElementById('detail-service').textContent = topic;
          document.getElementById('detail-quote-ar').textContent = quoteAr;
          document.getElementById('detail-quote-en').textContent = quoteEn;

          const badge = document.getElementById('detail-status-badge');
          badge.textContent = 'مسودة تجريبية (Demo / Draft)';
          badge.className = 'px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30';

          detailModal.classList.remove('hidden');
        });
      });

      // View Real Review Details Modal
      let activeDetailRev = null;
      document.querySelectorAll('.view-review-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rev = JSON.parse(btn.getAttribute('data-json') || '{}');
          activeDetailRev = rev;
          document.getElementById('detail-author').textContent = rev.author_name || '';
          document.getElementById('detail-title').textContent = rev.author_title_ar || rev.author_title_en || '';
          document.getElementById('detail-rating').textContent = '★'.repeat(Number(rev.rating) || 5) + ` (${rev.rating}/5)`;
          document.getElementById('detail-service').textContent = rev.service_title_ar || rev.service_title_en || 'تجربة عامة';
          document.getElementById('detail-quote-ar').textContent = rev.quote_ar || '—';
          document.getElementById('detail-quote-en').textContent = rev.quote_en || '—';

          const badge = document.getElementById('detail-status-badge');
          const st = Number(rev.is_approved);
          if (st === 1) {
            badge.textContent = 'معتمدة للنشر';
            badge.className = 'px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
          } else if (st === -1) {
            badge.textContent = 'مرفوضة';
            badge.className = 'px-2.5 py-1 rounded-full text-[11px] font-semibold bg-red-500/10 text-red-400 border border-red-500/20';
          } else {
            badge.textContent = 'بانتظار المراجعة';
            badge.className = 'px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20';
          }

          detailModal.classList.remove('hidden');
        });
      });

      document.getElementById('close-review-detail-btn')?.addEventListener('click', () => detailModal.classList.add('hidden'));
      document.getElementById('detail-accept-btn')?.addEventListener('click', async () => {
        if (!activeDetailRev) return;
        await updateReviewStatus(activeDetailRev, 1, 'تم اعتماد التقييم ونشره');
      });
      document.getElementById('detail-reject-btn')?.addEventListener('click', async () => {
        if (!activeDetailRev) return;
        await updateReviewStatus(activeDetailRev, -1, 'تم رفض التقييم');
      });

      // Seed 20 Test Review Models into SQLite as Drafts
      document.getElementById('seed-test-reviews-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('seed-test-reviews-btn');
        btn.disabled = true;
        btn.classList.add('opacity-50');

        try {
          const res = await fetch('/api/admin/reviews/seed-test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
          });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشل تحميل النماذج التجريبية');
          showToast(data.message, true);
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          btn.disabled = false;
          btn.classList.remove('opacity-50');
        }
      });

      function openAddModal() {
        form.reset();
        document.getElementById('review-form-id').value = '';
        document.getElementById('review-modal-title').textContent = 'إضافة مراجعة موثقة';
        modal.classList.remove('hidden');
      }

      document.getElementById('open-add-review-btn')?.addEventListener('click', openAddModal);
      document.getElementById('close-review-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));
      document.getElementById('cancel-review-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('review-form-id').value.trim();
        const isEdit = Boolean(id);

        const payload = {
          author_name: document.getElementById('review-author-name').value.trim(),
          author_title_ar: document.getElementById('review-author-title').value.trim() || null,
          author_title_en: document.getElementById('review-author-title').value.trim() || null,
          service_id: document.getElementById('review-service-id').value || null,
          rating: Number(document.getElementById('review-rating').value) || 5,
          quote_ar: document.getElementById('review-quote-ar').value.trim(),
          quote_en: document.getElementById('review-quote-en').value.trim(),
          is_approved: document.getElementById('review-is-approved').checked ? 1 : 0,
          is_verified: document.getElementById('review-is-verified').checked ? 1 : 0,
        };

        const saveBtn = document.getElementById('save-review-btn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'جاري الحفظ...';

        try {
          const endpoint = isEdit ? `/api/admin/reviews/${encodeURIComponent(id)}` : '/api/admin/reviews';
          const method = isEdit ? 'PUT' : 'POST';

          const res = await fetch(endpoint, {
            method,
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشلت العملية');

          showToast(data.message || 'تم الحفظ بنجاح', true);
          modal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'حفظ المراجعة';
        }
      });

      let targetReviewId = null;
      document.querySelectorAll('.delete-review-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          targetReviewId = btn.getAttribute('data-id');
          document.getElementById('delete-review-name').textContent = btn.getAttribute('data-name');
          deleteModal.classList.remove('hidden');
        });
      });

      document.getElementById('cancel-review-delete-btn')?.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
        targetReviewId = null;
      });

      document.getElementById('confirm-review-delete-btn')?.addEventListener('click', async () => {
        if (!targetReviewId) return;
        const confirmBtn = document.getElementById('confirm-review-delete-btn');
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'جاري الحذف...';

        try {
          const res = await fetch(`/api/admin/reviews/${encodeURIComponent(targetReviewId)}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشل الحذف');

          showToast('تم حذف المراجعة بنجاح', true);
          deleteModal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'نعم، حذف';
        }
      });
    });
  </script>
</AdminLayout>
