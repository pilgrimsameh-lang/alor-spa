---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import MediaPickerModal from '../../../components/admin/MediaPickerModal.astro';
import { getDb } from '../../../server/db/index';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const queryLang = Astro.url.searchParams.get('lang');
const cookieLang = Astro.cookies.get('alor_admin_lang')?.value;
const lang: 'ar' | 'en' = (queryLang === 'en' || (!queryLang && cookieLang === 'en')) ? 'en' : 'ar';
const isRtl = lang === 'ar';

const { client } = getDb();
const blogRes = await client.execute(`
  SELECT b.*, m.public_url as image_url, m.original_name as image_name
  FROM blog_posts b
  LEFT JOIN media_files m ON b.featured_image_id = m.id
  ORDER BY b.created_at DESC;
`);

const blogPosts = blogRes.rows;
---

<AdminLayout title={isRtl ? 'المدونة والمقالات' : 'Blog & Articles'} requiredPermission="blog:read">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-['Amiri',serif] text-[#FAF7F2] mb-1">
        {isRtl ? 'مقالات المدونة والعناية' : 'Wellness & Beauty Blog'}
      </h1>
      <p class="text-xs sm:text-sm text-[#D8C4A3]/70 font-light">
        {isRtl ? 'إنشاء وتعديل ونشر مقالات الصحة والجمال وطقوس الاسترخاء الفاخرة' : 'Draft, edit and publish wellness articles and spa ritual guides'}
      </p>
    </div>

    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#241814] border border-[#A87952]/25 text-[#D8C4A3]">
        <span class="text-[#C5A880] font-bold" id="blog-count-badge">{blogPosts.length}</span>
        <span>{isRtl ? 'مقالات' : 'Articles'}</span>
      </span>

      <button
        type="button"
        id="open-add-blog-btn"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] transition-all shadow-md shadow-[#A87952]/20 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>{isRtl ? 'كتابة مقال جديد' : 'Write Article'}</span>
      </button>
    </div>
  </div>

  <!-- Toast -->
  <div id="blog-toast" class="hidden fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span id="blog-toast-icon"></span>
      <span id="blog-toast-msg" class="text-xs font-medium"></span>
    </div>
    <button type="button" onclick="document.getElementById('blog-toast').classList.add('hidden')" class="text-xs opacity-70 hover:opacity-100">✕</button>
  </div>

  <!-- Content List or Empty State -->
  {blogPosts.length === 0 ? (
    <div id="blog-empty-container">
      <EmptyState
        title={isRtl ? 'لا توجد مقالات منشورة في المدونة' : 'No Blog Posts Published Yet'}
        description={isRtl
          ? 'قسم المدونة جاهز تماماً. انقر على زر كتابة مقال جديد لإضافة أول مقال تثقيفي ثنائي اللغة لتعزيز محتوى الموقع ومحركات البحث.'
          : 'Blog section is connected. Click Write Article to publish bilingual wellness content.'}
        actionText={isRtl ? 'كتابة أول مقال' : 'Write First Article'}
        actionHref="#open-modal"
        lang={lang}
      />
    </div>
  ) : (
    <div class="rounded-2xl border border-[#A87952]/20 bg-[#1C130D]/70 overflow-hidden shadow-xl backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-start border-collapse">
          <thead>
            <tr class="border-b border-[#A87952]/20 bg-[#140D09]/80 text-[#D8C4A3]/70 text-[11px] uppercase tracking-wider font-semibold">
              <th class="py-4 px-6 text-start">{isRtl ? 'عنوان المقال' : 'Title'}</th>
              <th class="py-4 px-6 text-start">{isRtl ? 'الكاتب' : 'Author'}</th>
              <th class="py-4 px-6 text-center">{isRtl ? 'الحالة' : 'Status'}</th>
              <th class="py-4 px-6 text-center">{isRtl ? 'الإجراءات' : 'Actions'}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#A87952]/10 text-xs">
            {blogPosts.map((post) => (
              <tr class="hover:bg-[#241814]/60 transition-colors" data-blog-id={post.id}>
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    {post.image_url ? (
                      <img src={post.image_url as string} alt={post.title_ar as string} class="w-10 h-10 rounded-lg object-cover border border-[#A87952]/30 shrink-0 bg-black/40" />
                    ) : (
                      <div class="w-10 h-10 rounded-lg bg-[#140D09] border border-[#A87952]/20 flex items-center justify-center text-[#D8C4A3]/30 shrink-0">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      </div>
                    )}
                    <div>
                      <div class="font-semibold text-[#FAF7F2]">{isRtl ? post.title_ar : post.title_en}</div>
                      <div class="text-[11px] text-[#D8C4A3]/50 font-mono">{post.slug}</div>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-[#D8C4A3]">
                  {post.author_name}
                </td>
                <td class="py-4 px-6 text-center">
                  {Number(post.is_published) === 1 ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span>{isRtl ? 'منشور' : 'Published'}</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      <span>{isRtl ? 'مسودة' : 'Draft'}</span>
                    </span>
                  )}
                </td>
                <td class="py-4 px-6 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <button
                      type="button"
                      class="edit-blog-btn p-1.5 rounded-lg text-[#C5A880] hover:bg-[#38251F] hover:text-[#FAF7F2] transition-colors cursor-pointer"
                      title={isRtl ? 'تعديل' : 'Edit'}
                      data-json={JSON.stringify(post)}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="delete-blog-btn p-1.5 rounded-lg text-red-400 hover:bg-red-950/40 hover:text-red-300 transition-colors cursor-pointer"
                      title={isRtl ? 'حذف' : 'Delete'}
                      data-id={post.id}
                      data-name={isRtl ? post.title_ar : post.title_en}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Add / Edit Modal -->
  <div id="blog-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-[#1C130D] border border-[#A87952]/40 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl my-8">
      <div class="p-6 border-b border-[#A87952]/20 flex items-center justify-between">
        <h3 id="blog-modal-title" class="text-lg font-bold font-['Amiri',serif] text-[#FAF7F2]">
          {isRtl ? 'كتابة مقال جديد' : 'Write New Article'}
        </h3>
        <button type="button" id="close-blog-modal-btn" class="text-[#D8C4A3]/60 hover:text-[#FAF7F2] text-xl cursor-pointer">✕</button>
      </div>

      <form id="blog-form" class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
        <input type="hidden" id="blog-form-id" name="id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'عنوان المقال (عربي) *' : 'Title (Arabic) *'}</label>
            <input type="text" id="blog-title-ar" name="title_ar" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'عنوان المقال (إنجليزي) *' : 'Title (English) *'}</label>
            <input type="text" id="blog-title-en" name="title_en" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'الرابط الفريد (Slug) *' : 'Slug *'}</label>
            <input type="text" id="blog-slug" name="slug" required placeholder="benefits-of-moroccan-bath" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] font-mono focus:border-[#C5A880] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'اسم الكاتب' : 'Author Name'}</label>
            <input type="text" id="blog-author" name="author_name" value="ALOR SPA" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
        </div>

        <div class="mb-4">
          <MediaPickerModal
            id="blog-featured-image-picker"
            name="featured_image_id"
            label={isRtl ? 'صورة المقال البارزة (Media Asset)' : 'Featured Article Image'}
            lang={lang}
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'موجز المقال (عربي) *' : 'Excerpt (Arabic) *'}</label>
            <textarea id="blog-excerpt-ar" name="excerpt_ar" rows="2" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"></textarea>
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'موجز المقال (إنجليزي) *' : 'Excerpt (English) *'}</label>
            <textarea id="blog-excerpt-en" name="excerpt_en" rows="2" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"></textarea>
          </div>
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'المحتوى الكامل (عربي) *' : 'Content (Arabic) *'}</label>
          <textarea id="blog-content-ar" name="content_ar" rows="5" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"></textarea>
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'المحتوى الكامل (إنجليزي) *' : 'Content (English) *'}</label>
          <textarea id="blog-content-en" name="content_en" rows="5" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"></textarea>
        </div>

        <div class="pt-2">
          <label class="flex items-center gap-2 text-xs text-[#FAF7F2] cursor-pointer">
            <input type="checkbox" id="blog-is-published" name="is_published" checked class="rounded border-[#A87952]/40 bg-[#140D09] text-[#C5A880] focus:ring-0" />
            <span>{isRtl ? 'نشر المقال فوراً بالموقع' : 'Publish Article Live'}</span>
          </label>
        </div>

        <div class="pt-4 border-t border-[#A87952]/20 flex items-center justify-end gap-3">
          <button type="button" id="cancel-blog-modal-btn" class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer">
            {isRtl ? 'إلغاء' : 'Cancel'}
          </button>
          <button type="submit" id="save-blog-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] cursor-pointer shadow-md">
            {isRtl ? 'حفظ المقال' : 'Save Article'}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="blog-delete-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1C130D] border border-red-500/30 rounded-2xl w-full max-w-md p-6 shadow-2xl text-center">
      <div class="w-12 h-12 rounded-full bg-red-950/50 border border-red-500/40 text-red-400 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-[#FAF7F2] mb-2 font-['Amiri',serif]">
        {isRtl ? 'تأكيد حذف المقال' : 'Confirm Article Deletion'}
      </h3>
      <p class="text-xs text-[#D8C4A3]/80 mb-6 leading-relaxed">
        {isRtl ? 'هل أنت متأكد من حذف مقال' : 'Are you sure you want to delete'}
        <strong id="delete-blog-name" class="text-[#FAF7F2]"></strong>؟
      </p>
      <div class="flex items-center justify-center gap-3">
        <button type="button" id="cancel-blog-delete-btn" class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer">
          {isRtl ? 'إلغاء' : 'Cancel'}
        </button>
        <button type="button" id="confirm-blog-delete-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-red-600 hover:bg-red-700 text-white cursor-pointer shadow-md">
          {isRtl ? 'نعم، حذف' : 'Yes, Delete'}
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('blog-modal');
      const deleteModal = document.getElementById('blog-delete-modal');
      const form = document.getElementById('blog-form');
      const toast = document.getElementById('blog-toast');
      const toastMsg = document.getElementById('blog-toast-msg');
      const toastIcon = document.getElementById('blog-toast-icon');

      function showToast(message, isSuccess = true) {
        toast.className = `fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between ${
          isSuccess ? 'bg-[#142617] border-emerald-500/50 text-emerald-200' : 'bg-[#2b1111] border-red-500/50 text-red-200'
        }`;
        toastIcon.textContent = isSuccess ? '✓' : '✗';
        toastMsg.textContent = message;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 4000);
      }

      function openAddModal() {
        form.reset();
        document.getElementById('blog-form-id').value = '';
        document.getElementById('blog-modal-title').textContent = 'كتابة مقال جديد';
        const picker = document.getElementById('blog-featured-image-picker');
        if (picker && typeof picker.setSelectedMedia === 'function') {
          picker.setSelectedMedia('', '', '');
        }
        modal.classList.remove('hidden');
      }

      document.getElementById('open-add-blog-btn')?.addEventListener('click', openAddModal);
      document.querySelector('a[href="#open-modal"]')?.addEventListener('click', (e) => {
        e.preventDefault();
        openAddModal();
      });

      document.getElementById('close-blog-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));
      document.getElementById('cancel-blog-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));

      document.querySelectorAll('.edit-blog-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const post = JSON.parse(btn.getAttribute('data-json') || '{}');
          document.getElementById('blog-form-id').value = post.id || '';
          document.getElementById('blog-title-ar').value = post.title_ar || '';
          document.getElementById('blog-title-en').value = post.title_en || '';
          document.getElementById('blog-slug').value = post.slug || '';
          document.getElementById('blog-author').value = post.author_name || 'ALOR SPA';
          document.getElementById('blog-excerpt-ar').value = post.excerpt_ar || '';
          document.getElementById('blog-excerpt-en').value = post.excerpt_en || '';
          document.getElementById('blog-content-ar').value = post.content_ar || '';
          document.getElementById('blog-content-en').value = post.content_en || '';
          document.getElementById('blog-is-published').checked = Number(post.is_published) === 1;
          document.getElementById('blog-modal-title').textContent = 'تعديل المقال: ' + (post.title_ar || post.id);

          const picker = document.getElementById('blog-featured-image-picker');
          if (picker && typeof picker.setSelectedMedia === 'function') {
            picker.setSelectedMedia(post.featured_image_id, post.image_url, post.image_name);
          }

          modal.classList.remove('hidden');
        });
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('blog-form-id').value.trim();
        const isEdit = Boolean(id);

        const payload = {
          title_ar: document.getElementById('blog-title-ar').value.trim(),
          title_en: document.getElementById('blog-title-en').value.trim(),
          slug: document.getElementById('blog-slug').value.trim(),
          featured_image_id: document.getElementById('blog-featured-image-picker-value')?.value || null,
          author_name: document.getElementById('blog-author').value.trim() || 'ALOR SPA',
          excerpt_ar: document.getElementById('blog-excerpt-ar').value.trim(),
          excerpt_en: document.getElementById('blog-excerpt-en').value.trim(),
          content_ar: document.getElementById('blog-content-ar').value.trim(),
          content_en: document.getElementById('blog-content-en').value.trim(),
          is_published: document.getElementById('blog-is-published').checked ? 1 : 0,
        };

        const saveBtn = document.getElementById('save-blog-btn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'جاري الحفظ...';

        try {
          const endpoint = isEdit ? `/api/admin/blog/${encodeURIComponent(id)}` : '/api/admin/blog';
          const method = isEdit ? 'PUT' : 'POST';

          const res = await fetch(endpoint, {
            method,
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشلت العملية');

          showToast(data.message || 'تم الحفظ بنجاح', true);
          modal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'حفظ المقال';
        }
      });

      let targetBlogId = null;
      document.querySelectorAll('.delete-blog-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          targetBlogId = btn.getAttribute('data-id');
          document.getElementById('delete-blog-name').textContent = btn.getAttribute('data-name');
          deleteModal.classList.remove('hidden');
        });
      });

      document.getElementById('cancel-blog-delete-btn')?.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
        targetBlogId = null;
      });

      document.getElementById('confirm-blog-delete-btn')?.addEventListener('click', async () => {
        if (!targetBlogId) return;
        const confirmBtn = document.getElementById('confirm-blog-delete-btn');
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'جاري الحذف...';

        try {
          const res = await fetch(`/api/admin/blog/${encodeURIComponent(targetBlogId)}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشل الحذف');

          showToast('تم حذف المقال بنجاح', true);
          deleteModal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'نعم، حذف';
        }
      });
    });
  </script>
</AdminLayout>
