---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import MediaPickerModal from '../../../components/admin/MediaPickerModal.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const queryLang = Astro.url.searchParams.get('lang');
const cookieLang = Astro.cookies.get('alor_admin_lang')?.value;
const lang: 'ar' | 'en' = (queryLang === 'en' || (!queryLang && cookieLang === 'en')) ? 'en' : 'ar';
const isRtl = lang === 'ar';

const client = Astro.locals.dbClient!;
const offersRes = await client.execute(`
  SELECT o.*, m.public_url as image_url, m.original_name as image_name
  FROM offers o
  LEFT JOIN media_files m ON o.image_id = m.id
  ORDER BY o.display_order ASC;
`);

const offersList = offersRes.rows;
---

<AdminLayout title={isRtl ? 'إدارة العروض والباقات' : 'Offers & Packages'} requiredPermission="offers:read">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-['Amiri',serif] text-[#FAF7F2] mb-1">
        {isRtl ? 'العروض والباقات الترويجية' : 'Promotional Offers & Packages'}
      </h1>
      <p class="text-xs sm:text-sm text-[#D8C4A3]/70 font-light">
        {isRtl ? 'إنشاء وتعديل العروض الموسمية، باقات الدلال وتحديد التواريخ والأسعار' : 'Create, schedule, and manage promotional spa packages and seasonal discounts'}
      </p>
    </div>

    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#241814] border border-[#A87952]/25 text-[#D8C4A3]">
        <span class="text-[#C5A880] font-bold" id="offers-count-badge">{offersList.length}</span>
        <span>{isRtl ? 'عروض مسجلة' : 'Offers'}</span>
      </span>

      <button
        type="button"
        id="open-add-offer-btn"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] transition-all shadow-md shadow-[#A87952]/20 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>{isRtl ? 'إضافة عرض جديد' : 'Add New Offer'}</span>
      </button>
    </div>
  </div>

  <!-- Toast -->
  <div id="offer-toast" class="hidden fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span id="offer-toast-icon"></span>
      <span id="offer-toast-msg" class="text-xs font-medium"></span>
    </div>
    <button type="button" onclick="document.getElementById('offer-toast').classList.add('hidden')" class="text-xs opacity-70 hover:opacity-100">✕</button>
  </div>

  <!-- Content List or Empty State -->
  {offersList.length === 0 ? (
    <div id="offers-empty-container">
      <EmptyState
        title={isRtl ? 'لا توجد عروض أو باقات ترويجية حالياً' : 'No Promotional Packages Yet'}
        description={isRtl
          ? 'لم يتم إنشاء أي باقة ترويجية بعد. انقر على زر إضافة عرض جديد لبدء إنشاء باقة ترويجية مرتبطة بقاعدة البيانات.'
          : 'No promotional packages have been recorded yet. Click Add New Offer to publish one.'}
        actionText={isRtl ? 'إضافة أول باقة ترويجية' : 'Create First Offer'}
        actionHref="#open-modal"
        lang={lang}
      />
    </div>
  ) : (
    <div class="rounded-2xl border border-[#A87952]/20 bg-[#1C130D]/70 overflow-hidden shadow-xl backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-start border-collapse">
          <thead>
            <tr class="border-b border-[#A87952]/20 bg-[#140D09]/80 text-[#D8C4A3]/70 text-[11px] uppercase tracking-wider font-semibold">
              <th class="py-4 px-6 text-start">{isRtl ? 'عنوان العرض' : 'Offer Title'}</th>
              <th class="py-4 px-6 text-start">{isRtl ? 'الشارة الترويجية' : 'Badge'}</th>
              <th class="py-4 px-6 text-start">{isRtl ? 'السعر' : 'Price'}</th>
              <th class="py-4 px-6 text-center">{isRtl ? 'مميز' : 'Featured'}</th>
              <th class="py-4 px-6 text-center">{isRtl ? 'الحالة' : 'Status'}</th>
              <th class="py-4 px-6 text-center">{isRtl ? 'الإجراءات' : 'Actions'}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#A87952]/10 text-xs">
            {offersList.map((offer) => (
              <tr class="hover:bg-[#241814]/60 transition-colors" data-offer-id={offer.id}>
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    {offer.image_url ? (
                      <img src={offer.image_url as string} alt={offer.title_ar as string} class="w-10 h-10 rounded-lg object-cover border border-[#A87952]/30 shrink-0 bg-black/40" />
                    ) : (
                      <div class="w-10 h-10 rounded-lg bg-[#140D09] border border-[#A87952]/20 flex items-center justify-center text-[#D8C4A3]/30 shrink-0">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      </div>
                    )}
                    <div>
                      <div class="font-semibold text-[#FAF7F2]">{isRtl ? offer.title_ar : offer.title_en}</div>
                      <div class="text-[11px] text-[#D8C4A3]/50 font-mono">{offer.slug}</div>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-[#C5A880]">
                  {offer.badge_ar ? (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] bg-[#A87952]/20 border border-[#C5A880]/30">
                      {isRtl ? offer.badge_ar : offer.badge_en}
                    </span>
                  ) : '—'}
                </td>
                <td class="py-4 px-6 text-[#FAF7F2] font-medium">
                  {isRtl ? offer.price_display_ar : offer.price_display_en}
                </td>
                <td class="py-4 px-6 text-center">
                  {Number(offer.is_featured) === 1 ? (
                    <span class="text-amber-400 font-bold">★ {isRtl ? 'نعم' : 'Yes'}</span>
                  ) : '—'}
                </td>
                <td class="py-4 px-6 text-center">
                  {Number(offer.is_active) === 1 ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span>{isRtl ? 'نشط' : 'Active'}</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      <span>{isRtl ? 'مسودة' : 'Draft'}</span>
                    </span>
                  )}
                </td>
                <td class="py-4 px-6 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <button
                      type="button"
                      class="edit-offer-btn p-1.5 rounded-lg text-[#C5A880] hover:bg-[#38251F] hover:text-[#FAF7F2] transition-colors cursor-pointer"
                      title={isRtl ? 'تعديل العرض' : 'Edit Offer'}
                      data-json={JSON.stringify(offer)}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="delete-offer-btn p-1.5 rounded-lg text-red-400 hover:bg-red-950/40 hover:text-red-300 transition-colors cursor-pointer"
                      title={isRtl ? 'حذف العرض' : 'Delete Offer'}
                      data-id={offer.id}
                      data-name={isRtl ? offer.title_ar : offer.title_en}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Add / Edit Modal -->
  <div id="offer-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-[#1C130D] border border-[#A87952]/40 rounded-2xl w-full max-w-xl overflow-hidden shadow-2xl my-8">
      <div class="p-6 border-b border-[#A87952]/20 flex items-center justify-between">
        <h3 id="offer-modal-title" class="text-lg font-bold font-['Amiri',serif] text-[#FAF7F2]">
          {isRtl ? 'إضافة باقة ترويجية جديدة' : 'Add New Offer'}
        </h3>
        <button type="button" id="close-offer-modal-btn" class="text-[#D8C4A3]/60 hover:text-[#FAF7F2] text-xl cursor-pointer">✕</button>
      </div>

      <form id="offer-form" class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
        <input type="hidden" id="offer-form-id" name="id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'عنوان العرض (عربي) *' : 'Title (Arabic) *'}</label>
            <input type="text" id="offer-title-ar" name="title_ar" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'عنوان العرض (إنجليزي) *' : 'Title (English) *'}</label>
            <input type="text" id="offer-title-en" name="title_en" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'الرابط الفريد (Slug) *' : 'Slug *'}</label>
            <input type="text" id="offer-slug" name="slug" required placeholder="vip-moroccan-bath-offer" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] font-mono focus:border-[#C5A880] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'الشارة الترويجية (مثال: خصم 20%)' : 'Promo Badge'}</label>
            <input type="text" id="offer-badge-ar" name="badge_ar" placeholder="عرض حصري" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'السعر (بالهللات)' : 'Price (Halalas)'}</label>
            <input type="number" id="offer-price-halalas" name="price_amount_halalas" placeholder="49000" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] font-mono focus:border-[#C5A880] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'السعر المعروض (عربي)' : 'Display Price (Arabic)'}</label>
            <input type="text" id="offer-price-display-ar" name="price_display_ar" value="الأسعار عند الاستفسار" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
          </div>
        </div>

        <div class="mb-4">
          <MediaPickerModal
            id="offer-image-picker"
            name="image_id"
            label={isRtl ? 'صورة الباقة أو العرض (Media Asset)' : 'Offer Image'}
            lang={lang}
          />
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'تفاصيل العرض (عربي) *' : 'Description (Arabic) *'}</label>
          <textarea id="offer-desc-ar" name="description_ar" rows="3" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"></textarea>
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'تفاصيل العرض (إنجليزي) *' : 'Description (English) *'}</label>
          <textarea id="offer-desc-en" name="description_en" rows="3" required class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-2">
          <label class="flex items-center gap-2 text-xs text-[#FAF7F2] cursor-pointer">
            <input type="checkbox" id="offer-is-featured" name="is_featured" class="rounded border-[#A87952]/40 bg-[#140D09] text-[#C5A880] focus:ring-0" />
            <span>{isRtl ? 'عرض مميز في واجهة الموقع' : 'Featured on Homepage'}</span>
          </label>
          <label class="flex items-center gap-2 text-xs text-[#FAF7F2] cursor-pointer">
            <input type="checkbox" id="offer-is-active" name="is_active" checked class="rounded border-[#A87952]/40 bg-[#140D09] text-[#C5A880] focus:ring-0" />
            <span>{isRtl ? 'العرض مفعل ونشط' : 'Active Offer'}</span>
          </label>
        </div>

        <div class="pt-4 border-t border-[#A87952]/20 flex items-center justify-end gap-3">
          <button type="button" id="cancel-offer-modal-btn" class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer">
            {isRtl ? 'إلغاء' : 'Cancel'}
          </button>
          <button type="submit" id="save-offer-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] cursor-pointer shadow-md">
            {isRtl ? 'حفظ العرض' : 'Save Offer'}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="offer-delete-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1C130D] border border-red-500/30 rounded-2xl w-full max-w-md p-6 shadow-2xl text-center">
      <div class="w-12 h-12 rounded-full bg-red-950/50 border border-red-500/40 text-red-400 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-[#FAF7F2] mb-2 font-['Amiri',serif]">
        {isRtl ? 'تأكيد حذف العرض' : 'Confirm Offer Deletion'}
      </h3>
      <p class="text-xs text-[#D8C4A3]/80 mb-6 leading-relaxed">
        {isRtl ? 'هل أنت متأكد من حذف العرض' : 'Are you sure you want to delete'}
        <strong id="delete-offer-name" class="text-[#FAF7F2]"></strong>؟
      </p>
      <div class="flex items-center justify-center gap-3">
        <button type="button" id="cancel-offer-delete-btn" class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer">
          {isRtl ? 'إلغاء' : 'Cancel'}
        </button>
        <button type="button" id="confirm-offer-delete-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-red-600 hover:bg-red-700 text-white cursor-pointer shadow-md">
          {isRtl ? 'نعم، حذف' : 'Yes, Delete'}
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('offer-modal');
      const deleteModal = document.getElementById('offer-delete-modal');
      const form = document.getElementById('offer-form');
      const toast = document.getElementById('offer-toast');
      const toastMsg = document.getElementById('offer-toast-msg');
      const toastIcon = document.getElementById('offer-toast-icon');

      function showToast(message, isSuccess = true) {
        toast.className = `fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between ${
          isSuccess ? 'bg-[#142617] border-emerald-500/50 text-emerald-200' : 'bg-[#2b1111] border-red-500/50 text-red-200'
        }`;
        toastIcon.textContent = isSuccess ? '✓' : '✗';
        toastMsg.textContent = message;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 4000);
      }

      function openAddModal() {
        form.reset();
        document.getElementById('offer-form-id').value = '';
        document.getElementById('offer-modal-title').textContent = 'إضافة باقة ترويجية جديدة';
        const picker = document.getElementById('offer-image-picker');
        if (picker && typeof picker.setSelectedMedia === 'function') {
          picker.setSelectedMedia('', '', '');
        }
        modal.classList.remove('hidden');
      }

      document.getElementById('open-add-offer-btn')?.addEventListener('click', openAddModal);
      document.querySelector('a[href="#open-modal"]')?.addEventListener('click', (e) => {
        e.preventDefault();
        openAddModal();
      });

      document.getElementById('close-offer-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));
      document.getElementById('cancel-offer-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));

      document.querySelectorAll('.edit-offer-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const offer = JSON.parse(btn.getAttribute('data-json') || '{}');
          document.getElementById('offer-form-id').value = offer.id || '';
          document.getElementById('offer-title-ar').value = offer.title_ar || '';
          document.getElementById('offer-title-en').value = offer.title_en || '';
          document.getElementById('offer-slug').value = offer.slug || '';
          document.getElementById('offer-badge-ar').value = offer.badge_ar || '';
          document.getElementById('offer-price-halalas').value = offer.price_amount_halalas ?? '';
          document.getElementById('offer-price-display-ar').value = offer.price_display_ar || 'الأسعار عند الاستفسار';
          document.getElementById('offer-desc-ar').value = offer.description_ar || '';
          document.getElementById('offer-desc-en').value = offer.description_en || '';
          document.getElementById('offer-is-featured').checked = Number(offer.is_featured) === 1;
          document.getElementById('offer-is-active').checked = Number(offer.is_active) === 1;
          document.getElementById('offer-modal-title').textContent = 'تعديل العرض: ' + (offer.title_ar || offer.id);

          const picker = document.getElementById('offer-image-picker');
          if (picker && typeof picker.setSelectedMedia === 'function') {
            picker.setSelectedMedia(offer.image_id, offer.image_url, offer.image_name);
          }

          modal.classList.remove('hidden');
        });
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('offer-form-id').value.trim();
        const isEdit = Boolean(id);

        const payload = {
          title_ar: document.getElementById('offer-title-ar').value.trim(),
          title_en: document.getElementById('offer-title-en').value.trim(),
          slug: document.getElementById('offer-slug').value.trim(),
          image_id: document.getElementById('offer-image-picker-value')?.value || null,
          badge_ar: document.getElementById('offer-badge-ar').value.trim() || null,
          badge_en: document.getElementById('offer-badge-ar').value.trim() || null,
          price_amount_halalas: document.getElementById('offer-price-halalas').value ? Number(document.getElementById('offer-price-halalas').value) : null,
          price_display_ar: document.getElementById('offer-price-display-ar').value.trim() || 'الأسعار عند الاستفسار',
          price_display_en: 'Price on inquiry',
          description_ar: document.getElementById('offer-desc-ar').value.trim(),
          description_en: document.getElementById('offer-desc-en').value.trim(),
          is_featured: document.getElementById('offer-is-featured').checked ? 1 : 0,
          is_active: document.getElementById('offer-is-active').checked ? 1 : 0,
          display_order: 0,
        };

        const saveBtn = document.getElementById('save-offer-btn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'جاري الحفظ...';

        try {
          const endpoint = isEdit ? `/api/admin/offers/${encodeURIComponent(id)}` : '/api/admin/offers';
          const method = isEdit ? 'PUT' : 'POST';

          const res = await fetch(endpoint, {
            method,
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشلت العملية');

          showToast(data.message || 'تم الحفظ بنجاح', true);
          modal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'حفظ العرض';
        }
      });

      let targetOfferId = null;
      document.querySelectorAll('.delete-offer-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          targetOfferId = btn.getAttribute('data-id');
          document.getElementById('delete-offer-name').textContent = btn.getAttribute('data-name');
          deleteModal.classList.remove('hidden');
        });
      });

      document.getElementById('cancel-offer-delete-btn')?.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
        targetOfferId = null;
      });

      document.getElementById('confirm-offer-delete-btn')?.addEventListener('click', async () => {
        if (!targetOfferId) return;
        const confirmBtn = document.getElementById('confirm-offer-delete-btn');
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'جاري الحذف...';

        try {
          const res = await fetch(`/api/admin/offers/${encodeURIComponent(targetOfferId)}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشل الحذف');

          showToast('تم حذف العرض بنجاح', true);
          deleteModal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'نعم، حذف';
        }
      });
    });
  </script>
</AdminLayout>
