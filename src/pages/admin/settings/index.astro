---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const queryLang = Astro.url.searchParams.get('lang');
const cookieLang = Astro.cookies.get('alor_admin_lang')?.value;
const lang: 'ar' | 'en' = (queryLang === 'en' || (!queryLang && cookieLang === 'en')) ? 'en' : 'ar';
const isRtl = lang === 'ar';

const client = Astro.locals.dbClient!;
const settingsRes = await client.execute(`
  SELECT key, value_ar, value_en, value_raw, group_name, data_type, is_public, is_immutable, updated_at
  FROM site_settings
  ORDER BY group_name ASC, key ASC;
`);

const settings = settingsRes.rows;
---

<AdminLayout title={isRtl ? 'إعدادات الموقع' : 'Site Settings'} requiredPermission="settings:read">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-['Amiri',serif] text-[#FAF7F2] mb-1">
        {isRtl ? 'إعدادات الموقع والهوية' : 'Site Settings & Configuration'}
      </h1>
      <p class="text-xs sm:text-sm text-[#D8C4A3]/70 font-light">
        {isRtl ? 'إدارة قنوات التواصل الرسمية، ساعات العمل، والقيود الأمنية المحمية' : 'Manage contact channels, business hours, and immutable security parameters'}
      </p>
    </div>

    <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#241814] border border-[#A87952]/25 text-[#D8C4A3]">
      <span class="text-[#C5A880] font-bold">{settings.length}</span>
      <span>{isRtl ? 'إعدادات مسجلة' : 'Settings'}</span>
    </span>
  </div>

  <!-- Toast -->
  <div id="settings-toast" class="hidden fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span id="settings-toast-icon"></span>
      <span id="settings-toast-msg" class="text-xs font-medium"></span>
    </div>
    <button type="button" onclick="document.getElementById('settings-toast').classList.add('hidden')" class="text-xs opacity-70 hover:opacity-100">✕</button>
  </div>

  <!-- Table -->
  <div class="rounded-2xl border border-[#A87952]/20 bg-[#1C130D]/70 overflow-hidden shadow-xl backdrop-blur-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-start border-collapse">
        <thead>
          <tr class="border-b border-[#A87952]/20 bg-[#140D09]/80 text-[#D8C4A3]/70 text-[11px] uppercase tracking-wider font-semibold">
            <th class="py-4 px-6 text-start">{isRtl ? 'المفتاح (Setting Key)' : 'Key'}</th>
            <th class="py-4 px-6 text-start">{isRtl ? 'المجموعة' : 'Group'}</th>
            <th class="py-4 px-6 text-start">{isRtl ? 'القيمة (عربي)' : 'Value (Arabic)'}</th>
            <th class="py-4 px-6 text-start">{isRtl ? 'القيمة (خام / إنجليزي)' : 'Value (Raw / English)'}</th>
            <th class="py-4 px-6 text-center">{isRtl ? 'حالة الحماية' : 'Protection'}</th>
            <th class="py-4 px-6 text-center">{isRtl ? 'الإجراءات' : 'Actions'}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#A87952]/10 text-xs">
          {settings.map((item) => {
            const isLocked = Number(item.is_immutable) === 1 || item.key === 'contact.whatsapp';

            return (
              <tr class="hover:bg-[#241814]/60 transition-colors" data-setting-key={item.key}>
                <td class="py-4 px-6 font-mono text-[11px] text-[#FAF7F2]">
                  {item.key}
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#38251F] text-[#C5A880] border border-[#C5A880]/30 font-mono">
                    {item.group_name}
                  </span>
                </td>
                <td class="py-4 px-6 text-[#FAF7F2]">
                  {item.value_ar || item.value_raw || '—'}
                </td>
                <td class="py-4 px-6 text-[#D8C4A3] font-mono text-[11px]">
                  {item.value_raw || item.value_en || '—'}
                </td>
                <td class="py-4 px-6 text-center">
                  {isLocked ? (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title={isRtl ? 'قيد أمان محمي من التعديل' : 'Immutable constraint'}>
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                      </svg>
                      <span>{isRtl ? 'محمي (Immutable)' : 'Locked'}</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#A87952]/15 text-[#C5A880]">
                      {isRtl ? 'قابل للتعديل' : 'Mutable'}
                    </span>
                  )}
                </td>
                <td class="py-4 px-6 text-center">
                  {isLocked ? (
                    <span class="text-[11px] text-[#D8C4A3]/40 cursor-not-allowed select-none" title={isRtl ? 'محمي ضد التغيير' : 'Locked'}>
                      🔒
                    </span>
                  ) : (
                    <button
                      type="button"
                      class="edit-setting-btn p-1.5 rounded-lg text-[#C5A880] hover:bg-[#38251F] hover:text-[#FAF7F2] transition-colors cursor-pointer"
                      title={isRtl ? 'تعديل الإعداد' : 'Edit Setting'}
                      data-json={JSON.stringify(item)}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Security Alert Banner -->
    <div class="p-4 border-t border-[#A87952]/15 bg-[#140D09]/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-[#D8C4A3]/70">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>
          {isRtl ? 'رقم الواتساب الرسمي (966553543192) محمي بصفة الأمان غير القابلة للتغيير.' : 'Official WhatsApp (966553543192) is cryptographically locked.'}
        </span>
      </div>
      <span class="font-mono text-[11px] text-[#C5A880]">
        whatsapp.official = 966553543192
      </span>
    </div>
  </div>

  <!-- Edit Setting Modal -->
  <div id="setting-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1C130D] border border-[#A87952]/40 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-6 border-b border-[#A87952]/20 flex items-center justify-between">
        <h3 id="setting-modal-title" class="text-lg font-bold font-['Amiri',serif] text-[#FAF7F2]">
          {isRtl ? 'تعديل الإعداد' : 'Edit Setting'}
        </h3>
        <button type="button" id="close-setting-modal-btn" class="text-[#D8C4A3]/60 hover:text-[#FAF7F2] text-xl cursor-pointer">✕</button>
      </div>

      <form id="setting-form" class="p-6 space-y-4">
        <input type="hidden" id="setting-form-key" name="key" />

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'المفتاح (Key)' : 'Key'}</label>
          <input type="text" id="setting-key-display" disabled class="w-full px-3 py-2 rounded-xl bg-[#140D09]/60 border border-[#A87952]/20 text-xs text-[#D8C4A3]/60 font-mono" />
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'القيمة بالعربية' : 'Value (Arabic)'}</label>
          <input type="text" id="setting-val-ar" name="value_ar" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'القيمة بالإنجليزية' : 'Value (English)'}</label>
          <input type="text" id="setting-val-en" name="value_en" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] focus:border-[#C5A880] focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs text-[#D8C4A3] mb-1">{isRtl ? 'القيمة الخام (Raw Value)' : 'Raw Value'}</label>
          <input type="text" id="setting-val-raw" name="value_raw" class="w-full px-3 py-2 rounded-xl bg-[#140D09] border border-[#A87952]/30 text-xs text-[#FAF7F2] font-mono focus:border-[#C5A880] focus:outline-none" />
        </div>

        <div class="pt-4 border-t border-[#A87952]/20 flex items-center justify-end gap-3">
          <button type="button" id="cancel-setting-modal-btn" class="px-4 py-2 rounded-xl text-xs text-[#D8C4A3] hover:text-[#FAF7F2] cursor-pointer">
            {isRtl ? 'إلغاء' : 'Cancel'}
          </button>
          <button type="submit" id="save-setting-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#A87952] to-[#7A5230] text-[#FAF7F2] hover:from-[#B88A60] hover:to-[#8C5D35] cursor-pointer shadow-md">
            {isRtl ? 'حفظ التعديل' : 'Save'}
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('setting-modal');
      const form = document.getElementById('setting-form');
      const toast = document.getElementById('settings-toast');
      const toastMsg = document.getElementById('settings-toast-msg');
      const toastIcon = document.getElementById('settings-toast-icon');

      function showToast(message, isSuccess = true) {
        toast.className = `fixed bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:w-96 p-4 rounded-xl shadow-2xl z-50 transition-all duration-300 border flex items-center justify-between ${
          isSuccess ? 'bg-[#142617] border-emerald-500/50 text-emerald-200' : 'bg-[#2b1111] border-red-500/50 text-red-200'
        }`;
        toastIcon.textContent = isSuccess ? '✓' : '✗';
        toastMsg.textContent = message;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 4000);
      }

      document.getElementById('close-setting-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));
      document.getElementById('cancel-setting-modal-btn')?.addEventListener('click', () => modal.classList.add('hidden'));

      document.querySelectorAll('.edit-setting-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = JSON.parse(btn.getAttribute('data-json') || '{}');
          document.getElementById('setting-form-key').value = item.key;
          document.getElementById('setting-key-display').value = item.key;
          document.getElementById('setting-val-ar').value = item.value_ar || '';
          document.getElementById('setting-val-en').value = item.value_en || '';
          document.getElementById('setting-val-raw').value = item.value_raw || '';
          document.getElementById('setting-modal-title').textContent = 'تعديل الإعداد: ' + item.key;
          modal.classList.remove('hidden');
        });
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const key = document.getElementById('setting-form-key').value.trim();

        const payload = {
          key,
          value_ar: document.getElementById('setting-val-ar').value.trim(),
          value_en: document.getElementById('setting-val-en').value.trim(),
          value_raw: document.getElementById('setting-val-raw').value.trim() || null,
        };

        const saveBtn = document.getElementById('save-setting-btn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'جاري الحفظ...';

        try {
          const res = await fetch(`/api/admin/settings/${encodeURIComponent(key)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Alor-Admin-Action': '1' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || 'فشلت العملية');

          showToast(data.message || 'تم تحديث الإعداد بنجاح', true);
          modal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          showToast(err.message, false);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'حفظ التعديل';
        }
      });
    });
  </script>
</AdminLayout>
