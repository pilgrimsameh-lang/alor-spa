# ALOR SPA Environment Configuration Template
# Copy this file to .env.local for local development, or set variables in your hosting environment.
# All values in this template are placeholders. Do not commit actual secrets to source control.

# ==============================================================================
# Public Client Variables (Safe for browser bundle — MUST start with PUBLIC_)
# ==============================================================================

# Official Site Canonical URL (e.g. https://alorspa.com)
SITE_URL=https://alorspa.com

# Official WhatsApp Booking Number (Saudi international format without + or spaces, e.g. 966553543192)
PUBLIC_WHATSAPP_NUMBER=

# Official Business Phone Number (for display and tel: link)
PUBLIC_PHONE_NUMBER=

# Official Contact Email
PUBLIC_CONTACT_EMAIL=

# Official Google Maps Embed URL or Location Query
PUBLIC_GOOGLE_MAPS_URL=

# ==============================================================================
# Private Server-Side Variables (NEVER expose to browser — NEVER prefix with PUBLIC_)
# ==============================================================================

# Server Runtime Settings
NODE_ENV=development
PORT=4321
HOST=localhost

# Required: Cryptographically secure random string (minimum 32 characters) for session security
SESSION_SECRET=

# Database Configuration (SQLite local path or cloud connection URL)
DB_PATH=./data/alor_spa.db

# Storage Driver (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
